---
import { baseCss } from '../lib/inlineCss'
import SiteNav from '../components/SiteNav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ThemeClock from '../components/ThemeClock.astro'

interface Props {
  title: string
  description?: string
  ogType?: 'website' | 'article'
  schema?: Record<string, unknown>
  /** Set on pages that open on a watercolour band: the header then floats
   *  over the artwork, the way it does on the homepage. */
  overlayNav?: boolean
  /** Absolute path or URL of the share card. Defaults to the homepage's. */
  ogImage?: string
  ogImageAlt?: string
}

const {
  title,
  description = 'Glyph is a free iOS web novel reader with community-built extensions. Browse dozens of novel sources, read offline, and customize your reading experience. No accounts, no tracking.',
  ogType = 'website',
  schema,
  overlayNav = false,
  ogImage: ogImageProp,
  ogImageAlt = 'Watercolor of a tower on a lake at dawn, two travelers on a road',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(ogImageProp ?? '/og-home.jpg', Astro.site)
const structuredData = schema ?? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalURL.href,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Glyph',
    url: 'https://glyph.moe',
  },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f1e6" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" id="favicon-icon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Glyph" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{title}</title>
    <style is:inline set:html={baseCss}></style>
    <slot name="head" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <ThemeClock />
  </head>
  <body class="inner-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class:list={['site-bar', overlayNav && 'site-bar--overlay']}>
      <SiteNav />
    </header>
    <slot />
    <SiteFooter />
  </body>
</html>
