---
import '../styles/global.css'
import Grain from '../components/Grain.astro'
import DocsTopBar from '../components/DocsTopBar.astro'
import Icon from '../components/Icon.astro'
import { getCollection, type MarkdownHeading } from 'astro:content'
import { getSearchIndex } from '../lib/searchIndex.ts'

interface Props {
  title: string
  currentSlug: string
  description?: string
  headings?: MarkdownHeading[]
  editUrl?: string
}

const { title, currentSlug, description, headings = [], editUrl } = Astro.props

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3)
const showToc = tocHeadings.length >= 2
const pageDescription =
  description ||
  `${title} | Glyph Documentation. Learn how to use Glyph, build extensions, and explore the SDK reference.`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og-image.png', Astro.site)

const allDocs = await getCollection('docs')
const sorted = allDocs.sort((a, b) => a.data.order - b.data.order)
const currentIndex = sorted.findIndex(d => d.id === currentSlug)
const prevDoc = currentIndex > 0 ? sorted[currentIndex - 1] : null
const nextDoc = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null

// Group docs by section, preserving order within each section
const sectionOrder = ['Using Glyph', 'Building Extensions', 'SDK Reference']
const sections = sectionOrder
  .map(name => ({ name, docs: sorted.filter(d => d.data.section === name) }))
  .filter(s => s.docs.length > 0)

// Local search index (no backend): title + section + description + headings
// per doc. Headings give the search body coverage the title-only index lacked.
// The client reads this via #search-index and does substring matching.
const searchIndex = await getSearchIndex()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f11" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={`${title} | Glyph Docs`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Glyph: An iOS reader for web novels" />
    <meta property="og:site_name" content="Glyph" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Glyph Docs`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="Glyph: An iOS reader for web novels" />

    <title>{title} | Glyph Docs</title>

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description: pageDescription,
        url: canonicalURL.href,
        publisher: {
          '@type': 'Organization',
          name: 'Glyph',
          url: 'https://glyph.moe',
        },
      })}
    />
    <script is:inline>
      ;(function () {
        var t = localStorage.getItem('theme')
        // Docs default to dark (landing follows prefers-color-scheme). A saved
        // choice always wins so the toggle persists across the site.
        if (t) document.documentElement.setAttribute('data-theme', t)
        else document.documentElement.setAttribute('data-theme', 'dark')
      })()
    </script>
    <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
  </head>
  <body>
    <Grain />
    <DocsTopBar />

    <div class="docs-shell">
      <div class="docs-sidebar-overlay" id="docs-sidebar-overlay"></div>
      <aside class="docs-sidebar" id="docs-sidebar">
        <button class="docs-search-trigger" id="docs-search-trigger" type="button">
          <Icon name="search" size={14} />
          <span>Search docs…</span>
          <kbd>⌘K</kbd>
        </button>
        {
          sections.map(section => (
            <div class="sidebar-section">
              <div class="sidebar-section-title">{section.name}</div>
              <nav class="sidebar-nav">
                {section.docs.map(doc => (
                  <a
                    href={`/docs/${doc.id}`}
                    class={`sidebar-link ${doc.id === currentSlug ? 'active' : ''}`}
                  >
                    {doc.data.title}
                  </a>
                ))}
              </nav>
            </div>
          ))
        }
      </aside>

      <main class:list={['docs-main', { 'has-toc': showToc }]}>
        <div class="docs-mobile-bar" id="docs-mobile-bar">
          <button class="docs-menu-btn" id="docs-menu-btn-inline" aria-label="Toggle docs menu">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"></path></svg
            >
            Menu
          </button>
          <div class="docs-mobile-nav">
            {
              prevDoc && (
                <a href={`/docs/${prevDoc.id}`} class="docs-mobile-arrow" aria-label="Previous">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M15 18l-6-6 6-6" />
                  </svg>
                </a>
              )
            }
            {
              nextDoc && (
                <a href={`/docs/${nextDoc.id}`} class="docs-mobile-arrow" aria-label="Next">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
        <div class="docs-content-row">
          <article class="docs-article">
            <slot />
          </article>

          {
            showToc && (
              <aside class="docs-toc" aria-label="On this page">
                <div class="docs-toc-title">On this page</div>
                <nav class="docs-toc-nav">
                  {tocHeadings.map(h => (
                    <a
                      href={`#${h.slug}`}
                      class:list={['docs-toc-link', `depth-${h.depth}`]}
                      data-slug={h.slug}
                    >
                      {h.text}
                    </a>
                  ))}
                </nav>
              </aside>
            )
          }
        </div>

        {
          editUrl && (
            <div class="docs-page-meta">
              <a href={editUrl} target="_blank" rel="noopener" class="docs-meta-link">
                <Icon name="pencil" size={14} />
                Edit this page on GitHub
              </a>
              <a
                href="https://github.com/Glyph-moe/website/issues/new"
                target="_blank"
                rel="noopener"
                class="docs-meta-link"
              >
                <Icon name="circle-help" size={14} />
                Report an issue
              </a>
            </div>
          )
        }

        <nav class="docs-pager" aria-label="Pagination">
          {
            prevDoc && (
              <a
                rel="prev"
                href={`/docs/${prevDoc.id}`}
                class="pager-cell pager-prev"
                aria-label={`Previous: ${prevDoc.data.title}`}
              >
                <span class="pager-chevron" aria-hidden="true">
                  <Icon name="chevron-left" size={18} />
                </span>
                <span class="pager-label">Previous</span>
              </a>
            )
          }
          {
            nextDoc && (
              <a
                rel="next"
                href={`/docs/${nextDoc.id}`}
                class="pager-cell pager-next"
                aria-label={`Next: ${nextDoc.data.title}`}
              >
                <span class="pager-stack">
                  <span class="pager-label">Next</span>
                  <span class="pager-title">{nextDoc.data.title}</span>
                </span>
                <span class="pager-chevron" aria-hidden="true">
                  <Icon name="chevron-right" size={18} />
                </span>
              </a>
            )
          }
        </nav>
      </main>
    </div>

    <div class="docs-search-overlay" id="docs-search-overlay" hidden>
      <div class="docs-search-modal" role="dialog" aria-modal="true" aria-label="Search docs">
        <div class="docs-search-input-row">
          <Icon name="search" size={16} />
          <input
            id="docs-search-input"
            type="text"
            placeholder="Search docs…"
            autocomplete="off"
            spellcheck="false"
          />
          <kbd>Esc</kbd>
        </div>
        <ul class="docs-search-results" id="docs-search-results"></ul>
      </div>
    </div>
    <script is:inline>
      ;(function () {
        var btn = document.getElementById('docs-menu-btn-inline')
        var sidebar = document.getElementById('docs-sidebar')
        var overlay = document.getElementById('docs-sidebar-overlay')
        if (!btn || !sidebar) return
        function close() {
          sidebar.classList.remove('open')
          overlay.classList.remove('open')
        }
        btn.addEventListener('click', function () {
          sidebar.classList.toggle('open')
          overlay.classList.toggle('open')
        })
        overlay.addEventListener('click', close)
        sidebar.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', close)
        })
      })()
    </script>
    <script is:inline>
      ;(function () {
        // ---- ⌘K search (local, no backend) ----
        var overlay = document.getElementById('docs-search-overlay')
        var trigger = document.getElementById('docs-search-trigger')
        var input = document.getElementById('docs-search-input')
        var resultsEl = document.getElementById('docs-search-results')
        var index = []
        var raw = document.getElementById('search-index')
        if (raw) {
          try {
            index = JSON.parse(raw.textContent || '[]')
          } catch (e) {
            index = []
          }
        }
        var active = -1
        var current = []

        function open() {
          if (!overlay) return
          overlay.hidden = false
          if (input)
            setTimeout(function () {
              input.focus()
            }, 10)
          if (input && !input.value) render('')
        }
        function close() {
          if (!overlay) return
          overlay.hidden = true
          if (input) input.value = ''
          active = -1
        }
        function score(item, q) {
          if (!q) return 1
          var t = item.title.toLowerCase()
          var d = (item.description || '').toLowerCase()
          var s = (item.section || '').toLowerCase()
          var h = (item.headings || '').toLowerCase()
          var qi = q.toLowerCase()
          if (t === qi) return 100
          if (t.indexOf(qi) === 0) return 80
          if (t.indexOf(qi) > -1) return 60
          if (h.indexOf(qi) > -1) return 55
          if (d.indexOf(qi) > -1) return 40
          if (s.indexOf(qi) > -1) return 30
          // token all-present across the whole blob
          var parts = qi.split(/\s+/).filter(Boolean)
          if (parts.length > 1) {
            var blob = t + ' ' + d + ' ' + s + ' ' + h
            if (
              parts.every(function (p) {
                return blob.indexOf(p) > -1
              })
            )
              return 20
          }
          return 0
        }
        function render(q) {
          if (!resultsEl) return
          var qs = q.trim()
          current = index
            .map(function (it) {
              return { it: it, s: score(it, qs) }
            })
            .filter(function (x) {
              return x.s > 0
            })
            .sort(function (a, b) {
              return b.s - a.s
            })
            .slice(0, 12)
            .map(function (x) {
              return x.it
            })
          active = current.length ? 0 : -1
          resultsEl.innerHTML = ''
          if (!current.length) {
            var li = document.createElement('li')
            li.className = 'docs-search-empty'
            li.textContent = qs ? 'No results for “' + qs + '”' : 'Type to search the docs…'
            resultsEl.appendChild(li)
            return
          }
          current.forEach(function (it, i) {
            var li = document.createElement('li')
            var a = document.createElement('a')
            a.href = '/docs/' + it.slug
            a.className = 'docs-search-item' + (i === active ? ' active' : '')
            var t = document.createElement('span')
            t.className = 'dsi-title'
            t.textContent = it.title
            var sec = document.createElement('span')
            sec.className = 'dsi-section'
            sec.textContent = it.section
            a.appendChild(t)
            a.appendChild(sec)
            a.addEventListener('mouseenter', function () {
              active = i
              updateActive()
            })
            li.appendChild(a)
            resultsEl.appendChild(li)
          })
        }
        function updateActive() {
          var items = resultsEl.querySelectorAll('.docs-search-item')
          items.forEach(function (el, i) {
            el.classList.toggle('active', i === active)
          })
          if (active >= 0 && items[active]) items[active].scrollIntoView({ block: 'nearest' })
        }
        function step(dir) {
          if (!current.length) return
          active = (active + dir + current.length) % current.length
          updateActive()
        }
        function choose() {
          if (active >= 0 && current[active]) window.location.href = '/docs/' + current[active].slug
        }

        if (trigger)
          trigger.addEventListener('click', function (e) {
            e.preventDefault()
            open()
          })
        if (overlay)
          overlay.addEventListener('click', function (e) {
            if (e.target === overlay) close()
          })
        if (input)
          input.addEventListener('input', function () {
            render(input.value)
          })
        if (input)
          input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
              e.preventDefault()
              step(1)
            } else if (e.key === 'ArrowUp') {
              e.preventDefault()
              step(-1)
            } else if (e.key === 'Enter') {
              e.preventDefault()
              choose()
            } else if (e.key === 'Escape') {
              e.preventDefault()
              close()
            }
          })
        document.addEventListener('keydown', function (e) {
          var mod = e.metaKey || e.ctrlKey
          if (mod && e.key.toLowerCase() === 'k') {
            e.preventDefault()
            overlay && overlay.hidden ? open() : close()
          }
          if (e.key === 'Escape' && overlay && !overlay.hidden) close()
        })

        // ---- Copy buttons + language header on code blocks ----
        document.querySelectorAll('.docs-article pre').forEach(function (pre) {
          if (pre.closest('.docs-pre-wrap')) return
          var wrap = document.createElement('div')
          wrap.className = 'docs-pre-wrap'
          pre.parentNode.insertBefore(wrap, pre)

          // Detect language from the code/pre class (shiki adds language-*)
          var code = pre.querySelector('code')
          var lang = ''
          var m = code && code.className.match(/language-([\w-]+)/)
          if (m) lang = m[1]
          if (!lang) {
            var m2 = pre.className.match(/language-([\w-]+)/)
            if (m2) lang = m2[1]
          }
          var pretty = {
            typescript: 'TypeScript',
            ts: 'TypeScript',
            javascript: 'JavaScript',
            js: 'JavaScript',
            bash: 'bash',
            shell: 'shell',
            sh: 'shell',
            text: 'text',
            plaintext: 'text',
            json: 'json',
            rust: 'rust',
            toml: 'toml',
            yaml: 'yaml',
            yml: 'yaml',
            md: 'markdown',
            markdown: 'markdown',
            html: 'html',
            css: 'css',
            wit: 'wit',
          }
          var label = pretty[lang] || lang || 'code'

          var header = document.createElement('div')
          header.className = 'docs-pre-header'
          var langEl = document.createElement('span')
          langEl.className = 'docs-pre-lang'
          langEl.textContent = label
          header.appendChild(langEl)
          wrap.appendChild(header)
          wrap.appendChild(pre)

          var btn = document.createElement('button')
          btn.type = 'button'
          btn.className = 'docs-copy-btn'
          btn.setAttribute('aria-label', 'Copy code')
          btn.textContent = 'Copy'
          btn.addEventListener('click', function () {
            var c = pre.querySelector('code')
            var text = c ? c.textContent : pre.textContent
            try {
              navigator.clipboard.writeText(text).then(function () {
                btn.textContent = 'Copied'
                setTimeout(function () {
                  btn.textContent = 'Copy'
                }, 1400)
              })
            } catch (err) {}
          })
          header.appendChild(btn)
        })
      })()
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .docs-shell {
    display: flex;
    min-height: 100vh;
    padding-top: 68px;
    position: relative;
    z-index: 1;
  }

  /* Sidebar */
  .docs-sidebar {
    position: sticky;
    top: 68px;
    width: 248px;
    height: calc(100vh - 68px);
    flex-shrink: 0;
    padding: 36px 28px;
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }

  .sidebar-section {
    margin-top: 24px;
  }

  .sidebar-section-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 6px 4px;
    margin-bottom: 6px;
  }

  .docs-search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 9px 12px;
    margin-bottom: 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 13.5px;
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }
  .docs-search-trigger:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .docs-search-trigger span {
    flex: 1;
    text-align: left;
  }
  .docs-search-trigger kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2px 6px;
    line-height: 1;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    position: relative;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-secondary);
    padding: 7px 12px;
    border-radius: 6px;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .sidebar-link:hover {
    color: var(--text);
    background: var(--bg-surface-hover);
  }
  .sidebar-link.active {
    color: var(--accent);
    font-weight: 500;
    background: transparent;
  }
  .sidebar-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Main */
  .docs-main {
    flex: 1;
    min-width: 0;
    padding: 56px 56px 96px;
    max-width: 780px;
  }
  .docs-main.has-toc {
    max-width: 1120px;
  }

  .docs-content-row {
    display: flex;
    gap: 64px;
    align-items: flex-start;
  }

  .docs-main.has-toc .docs-article {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  /* TOC */
  .docs-toc {
    position: sticky;
    top: 96px;
    width: 220px;
    flex-shrink: 0;
    max-height: calc(100vh - 116px);
    overflow-y: auto;
    padding-left: 8px;
  }

  .docs-toc-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 12px;
    padding-left: 12px;
  }

  .docs-toc-nav {
    display: flex;
    flex-direction: column;
  }

  .docs-toc-link {
    position: relative;
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-secondary);
    padding: 6px 12px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }
  .docs-toc-link.depth-3 {
    padding-left: 24px;
    font-size: 12.5px;
  }
  .docs-toc-link:hover {
    color: var(--text);
  }
  .docs-toc-link.active {
    color: var(--accent);
    font-weight: 500;
  }
  .docs-toc-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Article typography */
  .docs-article h1 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 36px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: 28px;
    scroll-margin-top: 88px;
  }

  .docs-article h2 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.015em;
    color: var(--text);
    margin-top: 48px;
    margin-bottom: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 88px;
  }

  .docs-article h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-top: 32px;
    margin-bottom: 10px;
    scroll-margin-top: 88px;
  }

  .docs-article h4 {
    scroll-margin-top: 88px;
  }

  .docs-article p {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 18px;
  }

  .docs-article a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
    padding-bottom: 1px;
    transition: border-bottom-style 0.18s ease;
  }
  .docs-article a:hover {
    border-bottom-style: solid;
  }

  .docs-article ul,
  .docs-article ol {
    padding-left: 24px;
    margin-bottom: 18px;
  }
  .docs-article li {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .docs-article blockquote {
    margin: 22px 0;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: var(--bg-surface);
    border-radius: 14px;
  }
  .docs-article blockquote p {
    color: var(--text);
    margin-bottom: 0;
