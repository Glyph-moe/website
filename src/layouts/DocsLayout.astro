---
import '../styles/global.css'
import Grain from '../components/Grain.astro'
import DocsTopBar from '../components/DocsTopBar.astro'
import Footer from '../components/Footer.astro'
import { getCollection, type MarkdownHeading } from 'astro:content'

interface Props {
  title: string
  currentSlug: string
  description?: string
  headings?: MarkdownHeading[]
}

const { title, currentSlug, description, headings = [] } = Astro.props

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3)
const showToc = tocHeadings.length >= 2
const pageDescription =
  description ||
  `${title} | Glyph Documentation. Learn how to use Glyph, build extensions, and explore the SDK reference.`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og-image.png', Astro.site)

const allDocs = await getCollection('docs')
const sorted = allDocs.sort((a, b) => a.data.order - b.data.order)
const currentIndex = sorted.findIndex(d => d.id === currentSlug)
const prevDoc = currentIndex > 0 ? sorted[currentIndex - 1] : null
const nextDoc = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null

// Group docs by section, preserving order within each section
const sectionOrder = ['Using Glyph', 'Building Extensions', 'SDK Reference']
const sections = sectionOrder
  .map(name => ({ name, docs: sorted.filter(d => d.data.section === name) }))
  .filter(s => s.docs.length > 0)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15110d" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={`${title} | Glyph Docs`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Glyph: An iOS reader for web novels" />
    <meta property="og:site_name" content="Glyph" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Glyph Docs`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="Glyph: An iOS reader for web novels" />

    <title>{title} | Glyph Docs</title>

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description: pageDescription,
        url: canonicalURL.href,
        publisher: {
          '@type': 'Organization',
          name: 'Glyph',
          url: 'https://glyph.moe',
        },
      })}
    />
    <script is:inline>
      ;(function () {
        var t = localStorage.getItem('theme')
        if (t) document.documentElement.setAttribute('data-theme', t)
      })()
    </script>
  </head>
  <body>
    <Grain />
    <DocsTopBar />

    <div class="docs-shell">
      <div class="docs-sidebar-overlay" id="docs-sidebar-overlay"></div>
      <aside class="docs-sidebar" id="docs-sidebar">
        {
          sections.map(section => {
            const isCurrent = section.docs.some(d => d.id === currentSlug)
            return (
              <details class="sidebar-section" open={isCurrent}>
                <summary class="sidebar-section-title">{section.name}</summary>
                <nav class="sidebar-nav">
                  {section.docs.map(doc => (
                    <a
                      href={`/docs/${doc.id}`}
                      class={`sidebar-link ${doc.id === currentSlug ? 'active' : ''}`}
                    >
                      {doc.data.title}
                    </a>
                  ))}
                </nav>
              </details>
            )
          })
        }
      </aside>

      <main class:list={['docs-main', { 'has-toc': showToc }]}>
        <div class="docs-mobile-bar" id="docs-mobile-bar">
          <button class="docs-menu-btn" id="docs-menu-btn-inline" aria-label="Toggle docs menu">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"></path></svg
            >
            Menu
          </button>
          <div class="docs-mobile-nav">
            {
              prevDoc && (
                <a href={`/docs/${prevDoc.id}`} class="docs-mobile-arrow" aria-label="Previous">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M15 18l-6-6 6-6" />
                  </svg>
                </a>
              )
            }
            {
              nextDoc && (
                <a href={`/docs/${nextDoc.id}`} class="docs-mobile-arrow" aria-label="Next">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
        <div class="docs-content-row">
          <article class="docs-article">
            <slot />
          </article>

          {
            showToc && (
              <aside class="docs-toc" aria-label="On this page">
                <div class="docs-toc-title">On this page</div>
                <nav class="docs-toc-nav">
                  {tocHeadings.map(h => (
                    <a
                      href={`#${h.slug}`}
                      class:list={['docs-toc-link', `depth-${h.depth}`]}
                      data-slug={h.slug}
                    >
                      {h.text}
                    </a>
                  ))}
                </nav>
              </aside>
            )
          }
        </div>

        <nav class="docs-pager">
          {
            prevDoc && (
              <a href={`/docs/${prevDoc.id}`} class="pager-link pager-prev">
                <span class="pager-label">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 18l-6-6 6-6" />
                  </svg>
                  Previous
                </span>
                <span class="pager-title">{prevDoc.data.title}</span>
              </a>
            )
          }
          {
            nextDoc && (
              <a href={`/docs/${nextDoc.id}`} class="pager-link pager-next">
                <span class="pager-label">
                  Next
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                </span>
                <span class="pager-title">{nextDoc.data.title}</span>
              </a>
            )
          }
        </nav>
      </main>
    </div>

    <Footer />
    <script is:inline>
      ;(function () {
        var btn = document.getElementById('docs-menu-btn-inline')
        var sidebar = document.getElementById('docs-sidebar')
        var overlay = document.getElementById('docs-sidebar-overlay')
        if (!btn || !sidebar) return
        function close() {
          sidebar.classList.remove('open')
          overlay.classList.remove('open')
        }
        btn.addEventListener('click', function () {
          sidebar.classList.toggle('open')
          overlay.classList.toggle('open')
        })
        overlay.addEventListener('click', close)
        sidebar.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', close)
        })
      })()
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .docs-shell {
    display: flex;
    min-height: 100vh;
    padding-top: 68px;
    position: relative;
    z-index: 1;
  }

  /* Sidebar */
  .docs-sidebar {
    position: sticky;
    top: 68px;
    width: 248px;
    height: calc(100vh - 68px);
    flex-shrink: 0;
    padding: 36px 28px;
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }

  .sidebar-section {
    margin-top: 24px;
  }
  .sidebar-section:first-of-type {
    margin-top: 0;
  }

  .sidebar-section-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 4px;
    margin-bottom: 6px;
    user-select: none;
    transition: color 0.15s;
  }
  .sidebar-section-title::-webkit-details-marker {
    display: none;
  }
  .sidebar-section-title::after {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s;
    opacity: 0.6;
  }
  .sidebar-section[open] > .sidebar-section-title::after {
    transform: rotate(45deg);
  }
  .sidebar-section-title:hover {
    color: var(--text);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    position: relative;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-secondary);
    padding: 7px 12px;
    border-radius: 6px;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .sidebar-link:hover {
    color: var(--text);
    background: var(--bg-surface-hover);
  }
  .sidebar-link.active {
    color: var(--accent);
    font-weight: 500;
    background: transparent;
  }
  .sidebar-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Main */
  .docs-main {
    flex: 1;
    min-width: 0;
    padding: 56px 56px 96px;
    max-width: 780px;
  }
  .docs-main.has-toc {
    max-width: 1120px;
  }

  .docs-content-row {
    display: flex;
    gap: 64px;
    align-items: flex-start;
  }

  .docs-main.has-toc .docs-article {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  /* TOC */
  .docs-toc {
    position: sticky;
    top: 96px;
    width: 220px;
    flex-shrink: 0;
    max-height: calc(100vh - 116px);
    overflow-y: auto;
    padding-left: 8px;
  }

  .docs-toc-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 12px;
    padding-left: 12px;
  }

  .docs-toc-nav {
    display: flex;
    flex-direction: column;
  }

  .docs-toc-link {
    position: relative;
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-secondary);
    padding: 6px 12px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }
  .docs-toc-link.depth-3 {
    padding-left: 24px;
    font-size: 12.5px;
  }
  .docs-toc-link:hover {
    color: var(--text);
  }
  .docs-toc-link.active {
    color: var(--accent);
    font-weight: 500;
  }
  .docs-toc-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Article typography */
  .docs-article h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 38px;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 32px;
    scroll-margin-top: 88px;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .docs-article h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.015em;
    color: var(--text);
    margin-top: 56px;
    margin-bottom: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 88px;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .docs-article h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--text);
    margin-top: 36px;
    margin-bottom: 12px;
    scroll-margin-top: 88px;
  }

  .docs-article h4 {
    scroll-margin-top: 88px;
  }

  .docs-article p {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 18px;
  }

  .docs-article a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
    padding-bottom: 1px;
    transition: border-bottom-style 0.18s ease;
  }
  .docs-article a:hover {
    border-bottom-style: solid;
  }

  .docs-article ul,
  .docs-article ol {
    padding-left: 24px;
    margin-bottom: 18px;
  }
  .docs-article li {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .docs-article blockquote {
    margin: 20px 0;
    padding: 14px 20px;
    border-left: 3px solid var(--accent);
    background: var(--accent-dim);
    border-radius: 0 8px 8px 0;
  }
  .docs-article blockquote p {
    color: var(--text);
    margin-bottom: 0;
    font-size: 15px;
  }
  .docs-article blockquote code {
    background: var(--bg-surface-hover);
  }

  .docs-article code {
    font-family: var(--font-mono);
    font-size: 13.5px;
    background: var(--bg-surface-hover);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text);
  }

  .docs-article pre {
    margin-bottom: 22px;
    padding: 18px 20px;
    border-radius: 8px;
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.65;
  }

  .docs-article pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .docs-article .docs-clip {
    margin: 32px 0;
    padding: 0;
  }
  .docs-article .docs-clip video {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
  }
  .docs-article .docs-clip figcaption {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-secondary);
    text-align: center;
    font-style: italic;
    font-family: var(--font-display);
  }

  .docs-article table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 14px;
  }
  .docs-article th {
    text-align: left;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--text);
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
  }
  .docs-article td {
    font-family: var(--font-body);
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }
  .docs-article td code {
    font-size: 12.5px;
  }

  /* Pager */
  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: transparent;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
    min-width: 0;
  }
  .pager-link:hover {
    border-color: var(--text-secondary);
  }
  .pager-link:hover .pager-title {
    color: var(--accent);
  }

  .pager-prev {
    grid-column: 1;
    align-items: flex-start;
  }
  .pager-next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .pager-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .pager-label svg {
    flex-shrink: 0;
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
    transition: color 0.18s ease;
  }

  @media (max-width: 640px) {
    .docs-pager {
      grid-template-columns: 1fr;
    }
    .pager-prev,
    .pager-next {
      grid-column: 1;
    }
    .pager-next {
      align-items: flex-start;
      text-align: left;
    }
  }

  /* Mobile bar + drawer */
  .docs-mobile-bar {
    display: none;
  }
  .docs-sidebar-overlay {
    display: none;
  }

  @media (max-width: 768px) {
    .docs-mobile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 56px;
      z-index: 50;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 16px 0 12px;
      margin: -12px 0 24px;
    }
    .docs-menu-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
      background: none;
      border: none;
      padding: 6px 2px;
      cursor: pointer;
      transition: color 0.18s;
    }
    .docs-menu-btn:hover {
      color: var(--text);
    }
    .docs-mobile-nav {
      display: flex;
      gap: 4px;
    }
    .docs-mobile-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      color: var(--text-secondary);
      border: 1px solid var(--border);
      transition:
        color 0.18s,
        border-color 0.18s;
    }
    .docs-mobile-arrow:hover {
      color: var(--text);
      border-color: var(--text-secondary);
    }
    .docs-sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 160;
      cursor: pointer;
    }
    .docs-sidebar-overlay.open {
      display: block;
    }
    .docs-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      height: 100%;
      z-index: 161;
      background: var(--bg);
      border-right: 1px solid var(--border);
      transform: translateX(-100%);
      transition: transform 0.22s ease;
      padding-top: 72px;
      overflow-y: auto;
    }
    .docs-sidebar.open {
      transform: translateX(0);
    }
    .docs-main {
      padding: 32px 24px 80px;
    }
  }

  @media (max-width: 1100px) {
    .docs-toc {
      display: none;
    }
    .docs-main.has-toc {
      max-width: 780px;
    }
    .docs-main.has-toc .docs-article {
      max-width: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var links = document.querySelectorAll('.docs-toc-link')
    if (!links.length) return

    var bySlug = {}
    links.forEach(function (a) {
      bySlug[a.getAttribute('data-slug')] = a
    })

    var headings = []
    Object.keys(bySlug).forEach(function (slug) {
      var el = document.getElementById(slug)
      if (el) headings.push(el)
    })
    if (!headings.length) return

    function setActive(slug) {
      links.forEach(function (a) {
        a.classList.toggle('active', a.getAttribute('data-slug') === slug)
      })
    }

    // Clicks on TOC links set the active state immediately. Without this, the
    // IntersectionObserver lags during smooth scroll and the highlight sticks
    // on the previous heading until the new one crosses the active band.
    var clickGuardUntil = 0
    links.forEach(function (a) {
      a.addEventListener('click', function () {
        setActive(a.getAttribute('data-slug'))
        clickGuardUntil = Date.now() + 700
      })
    })

    // IntersectionObserver: mark the heading whose section the user is reading.
    // rootMargin top -88px accounts for the sticky nav; bottom -65% means the
    // active heading is the most recent one whose top has crossed ~35% from
    // the top of the viewport.
    var observer = new IntersectionObserver(
      function (entries) {
        if (Date.now() < clickGuardUntil) return
        var visible = entries
          .filter(function (e) {
            return e.isIntersecting
          })
          .map(function (e) {
            return e.target
          })
        if (visible.length) {
          visible.sort(function (a, b) {
            return a.getBoundingClientRect().top - b.getBoundingClientRect().top
          })
          setActive(visible[0].id)
        }
      },
      { rootMargin: '-88px 0px -65% 0px', threshold: 0 },
    )

    headings.forEach(function (h) {
      observer.observe(h)
    })

    // Initial state: respect URL hash if present; otherwise pick the topmost
    // heading whose top is above the active band.
    function syncInitial() {
      if (location.hash) {
        var slug = location.hash.slice(1)
        if (bySlug[slug]) {
          setActive(slug)
          return
        }
      }
      var topBand = 88
      var current = headings[0]
      for (var i = 0; i < headings.length; i++) {
        if (headings[i].getBoundingClientRect().top - topBand <= 0) {
          current = headings[i]
        } else {
          break
        }
      }
      setActive(current.id)
    }
    syncInitial()
  })()
</script>
