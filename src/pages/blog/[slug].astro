---
import { render } from 'astro:content'
import BlogLayout from '../../layouts/BlogLayout.astro'
import PostCard from '../../components/blog/PostCard.astro'
import PostCover from '../../components/blog/PostCover.astro'
import {
  categoryHref,
  formatDate,
  getPublishedPosts,
  isoDate,
  postHref,
  readingTime,
  type BlogPost,
} from '../../lib/blog'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, description, date, category, mood, cx } = post.data

const posts = await getPublishedPosts()
const position = posts.findIndex(entry => entry.id === post.id)
// Newest first, so the entry before this one is newer and the one after is older.
const newer = position > 0 ? posts[position - 1] : null
const older = position < posts.length - 1 ? posts[position + 1] : null

const others = posts.filter(entry => entry.id !== post.id)
const keepReading = [
  ...others.filter(entry => entry.data.category === category),
  ...others.filter(entry => entry.data.category !== category),
].slice(0, 3)

const minutes = readingTime(post.body)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImagePath = `/blog/og/${post.id}.jpg`
const ogImage = new URL(ogImagePath, Astro.site)
const pageTitle = `${title} — Glyph Notes`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  url: canonicalURL.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
  image: ogImage.href,
  articleSection: category,
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'Glyph', url: 'https://glyph.moe' },
  publisher: { '@type': 'Organization', name: 'Glyph', url: 'https://glyph.moe' },
}
---

<BlogLayout
  title={pageTitle}
  description={description}
  ogType="article"
  ogImage={ogImagePath}
  ogImageAlt={`Cover of the post “${title}”`}
  schema={schema}
>
  <main id="main-content" class="blog-frame">
    <article>
      <header class="post-header">
        <a class="post-back" href="/blog">← All notes</a>
        <div>
          <a class="post-cat" href={categoryHref(category)}>{category}</a>
        </div>
        <h1>{title}</h1>
        <p class="post-meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </header>

      {
        /* The h1 above already says the title, so the band keeps only the sun
          and the painting: one headline per page, not two. */
      }
      <div class="post-cover">
        <PostCover
          mood={mood}
          title={title}
          cx={cx}
          size="wide"
          showTitle={false}
          showMeta={false}
          priority
          image={post.data.cover}
        />
      </div>

      <div class="post-reading">
        <p class="post-lede">{description}</p>
        <div class="post-body">
          <Content />
        </div>
      </div>
    </article>

    {
      keepReading.length > 0 && (
        <section class="post-more" aria-labelledby="keep-reading">
          <div class="post-more-head">
            <h2 id="keep-reading">Keep reading</h2>
            <a class="post-more-all" href="/blog">
              All notes →
            </a>
          </div>
          <ul class="blog-grid">
            {keepReading.map(entry => (
              <PostCard post={entry} reveal={false} />
            ))}
          </ul>
        </section>
      )
    }

    <nav class="post-pager" aria-label="Newer and older posts">
      {
        older ? (
          <a rel="prev" href={postHref(older)}>
            <span>Previous post</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a rel="next" href={postHref(newer)}>
            <span>Next post</span>
            <strong>{newer.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </main>
</BlogLayout>
