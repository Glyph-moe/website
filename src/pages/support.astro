---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import Icon from '../components/Icon.astro'
import heroSupport from '../assets/hero/hero-support.webp'

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const description =
  'Answers for Glyph setup, extensions, reading, offline downloads, iCloud sync, privacy, bug reports, and security disclosure.'
const bugSubject = 'Glyph bug report'
const bugBody = `iOS version and device model:\nGlyph version (Settings → About):\n\nSteps to reproduce:\n1. \n\nWhat you expected:\n\nWhat actually happened:\n\nDiagnostic report attached (if relevant): Yes / No\n`
const bugMailto = `mailto:contact@glyph.moe?subject=${encodeURIComponent(bugSubject)}&body=${encodeURIComponent(bugBody)}`
const securityMailto = `mailto:contact@glyph.moe?subject=${encodeURIComponent('Glyph security disclosure')}`
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Support | Glyph',
  description,
  url: canonicalURL.href,
  mainEntity: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'contact@glyph.moe',
    url: canonicalURL.href,
  },
}
---

<Base title="Support | Glyph" description={description} schema={schema} overlayNav>
  <main id="main-content" class="support-main">
    <PageHero
      title="Support"
      lede="Answers for setup, reading, sync, and privacy. If yours isn’t here, email contact@glyph.moe."
      artPosition="50% 54%"
      art={heroSupport}
      artAlt="Illustration for the Glyph support page"
    >
      <a class="support-primary" href="mailto:contact@glyph.moe">Email support</a>
      <a class="support-secondary" href="#report-bug">Report a bug</a>
    </PageHero>

    <div class="support-layout">
      <aside class="support-index" aria-labelledby="support-index-title">
        <h2 id="support-index-title">Start with the problem.</h2>
        <p>Open a question for a short answer, or use the guides for the full steps.</p>
        <nav aria-label="Support topics">
          <a href="#sources-setup">Sources & setup <span aria-hidden="true">→</span></a>
          <a href="#reading-offline">Reading & offline <span aria-hidden="true">→</span></a>
          <a href="#sync-privacy-data">Sync, privacy & data <span aria-hidden="true">→</span></a>
        </nav>
        <p class="support-guides">
          More in the <a href="/docs/faq">full FAQ</a> and the
          <a href="/docs/troubleshooting">Troubleshooting guide</a>.
        </p>
      </aside>

      <div class="support-groups">
        <section class="support-group" id="sources-setup" aria-labelledby="sources-setup-title">
          <header class="support-group-heading">
            <div>
              <h2 id="sources-setup-title">Sources & setup</h2>
              <p>Add a repository, install a source, or get a source fetching again.</p>
            </div>
          </header>

          <details class="support-question">
            <summary
              >How do I add a novel source?<span class="question-marker" aria-hidden="true"
              ></span></summary
            >
            <div class="support-answer">
              <p>
                Glyph doesn't ship with any sources. Go to Settings → Extensions → tap <strong
                  >+</strong
                >, paste a repository URL (shared by the community), tap <strong>Fetch</strong>,
                then
                <strong>Install</strong>. Installed sources show up in the Browse tab.
              </p>
            </div>
          </details>

          <details class="support-question">
            <summary
              >An extension won’t load or won’t fetch anything.<span
                class="question-marker"
                aria-hidden="true"></span></summary
            >
            <div class="support-answer">
              <p>
                Go to Settings → Extensions → tap the repository → <strong>Refresh</strong> the source.
                If that doesn't help, Settings → Storage → <strong>Clear Extension Cache</strong>,
                then reopen the app.
              </p>
            </div>
          </details>
        </section>

        <section class="support-group" id="reading-offline" aria-labelledby="reading-offline-title">
          <header class="support-group-heading">
            <div>
              <h2 id="reading-offline-title">Reading & offline</h2>
              <p>Fix a stuck chapter, reopen a stalled reader, or save chapters for later.</p>
            </div>
          </header>

          <details class="support-question">
            <summary
              >A chapter says “Could not load chapter”.<span
                class="question-marker"
                aria-hidden="true"></span></summary
            >
            <div class="support-answer">
              <p>
                Usually the novel site is down or blocking requests, or your connection dropped. Tap
                <strong>Retry</strong>. If it keeps happening, check whether the extension has an
                update in Settings → Extensions.
              </p>
            </div>
          </details>

          <details class="support-question">
            <summary
              >The reader shows a white screen or loads forever.<span
                class="question-marker"
                aria-hidden="true"></span></summary
            >
            <div class="support-answer">
              <p>
                Go back and reopen the chapter. If it's still stuck, Settings → Storage →
                <strong>Clear Extension Cache</strong>, then try again; the extension may need to
                refetch the content.
              </p>
            </div>
          </details>

          <details class="support-question">
            <summary
              >Can I read offline?<span class="question-marker" aria-hidden="true"></span></summary
            >
            <div class="support-answer">
              <p>
                Yes. On a novel's detail page, tap the download icon to save chapters, or all of
                them. Downloads live on your device and read without a connection. The Downloads
                section in your Library shows what's saved and how much storage it uses.
              </p>
            </div>
          </details>
        </section>

        <section
          class="support-group"
          id="sync-privacy-data"
          aria-labelledby="sync-privacy-data-title"
        >
          <header class="support-group-heading">
            <div>
              <h2 id="sync-privacy-data-title">Sync, privacy & data</h2>
              <p>Check iCloud sync, local storage, tracking, and deletion.</p>
            </div>
          </header>

          <details class="support-question">
            <summary
              >Does Glyph track me?<span class="question-marker" aria-hidden="true"></span></summary
            >
            <div class="support-answer">
              <p>
                No. No analytics, no accounts, no tracking. Your library and reading progress stay
                on your device, syncing only through your own iCloud if you're signed in. Extensions
                run sandboxed and can only reach their declared site.
              </p>
            </div>
          </details>

          <details class="support-question">
            <summary
              >My reading progress didn’t appear on a new device.<span
                class="question-marker"
                aria-hidden="true"></span></summary
            >
            <div class="support-answer">
              <p>
                Progress syncs through iCloud. Make sure you're signed into the same Apple ID and
                that iCloud Drive is enabled for Glyph (Settings → iCloud), then give it a few
                minutes to sync.
              </p>
            </div>
          </details>

          <details class="support-question">
            <summary
              >How do I delete my data?<span class="question-marker" aria-hidden="true"
              ></span></summary
            >
            <div class="support-answer">
              <p>
                Everything is stored locally on your device. Remove novels one by one, or in
                Settings → Storage clear reading history, downloads, or the extension cache.
                Deleting the app removes all of it.
              </p>
            </div>
          </details>
        </section>
      </div>
    </div>

    <section class="bug-report" id="report-bug" aria-labelledby="bug-report-title">
      <div class="bug-report-intro">
        <h2 id="bug-report-title">Report a bug</h2>
        <p>
          Email <a href="mailto:contact@glyph.moe">contact@glyph.moe</a> with as much of the checklist
          as you can. The button starts an email with those fields already in place.
        </p>
        <a class="support-primary" data-bug-report href={bugMailto}>Start a bug report</a>
        <p class="bug-note">
          Diagnostic reports never leave your device unless you share them. They carry app logs and
          network history, no personal data. See the <a href="/privacy">Privacy Policy</a>.
        </p>
      </div>
      <ul class="support-checklist">
        <li><Icon name="check" size={18} /><span>iOS version and device model</span></li>
        <li><Icon name="check" size={18} /><span>Glyph version (Settings → About)</span></li>
        <li><Icon name="check" size={18} /><span>Steps to reproduce</span></li>
        <li>
          <Icon name="check" size={18} /><span>What you expected vs. what actually happened</span>
        </li>
        <li>
          <Icon name="check" size={18} />
          <span>A diagnostic report (Settings → Share Diagnostic Report), if relevant</span>
        </li>
      </ul>
    </section>

    <section class="support-security" aria-labelledby="security-title">
      <h2 id="security-title">Security disclosure</h2>
      <div>
        <p>
          Found a vulnerability in the app, the SDK, the CLI, or an official extension? Email
          <a href="mailto:contact@glyph.moe">contact@glyph.moe</a> directly rather than opening a public
          issue. I'll acknowledge within 72 hours.
        </p>
        <a class="security-link" href={securityMailto}>Email a security disclosure</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .support-main {
    max-width: 1680px;
    margin: 0 auto;
  }

  .support-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 16px;
    font-weight: 650;
    text-decoration: none;
  }

  .support-secondary,
  .security-link {
    color: var(--ink);
    font-size: 16px;
    font-weight: 650;
    text-underline-offset: 5px;
  }

  .support-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px var(--page-gutter);
    margin: 136px var(--page-margin) 0;
  }

  .support-index {
    grid-column: 1 / 5;
    align-self: start;
  }

  .support-index h2,
  .support-group h2,
  .bug-report h2,
  .support-security h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .support-index > p,
  .support-group-heading p {
    max-width: 40ch;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .support-index nav {
    display: grid;
    margin-top: 32px;
  }

  .support-index nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    color: var(--ink);
    font-size: 20px;
    font-weight: 650;
    line-height: 1.3;
    text-decoration: none;
  }

  .support-index nav a span {
    color: var(--accent);
  }

  .support-index .support-guides {
    margin-top: 32px;
    font-size: 14px;
  }

  .support-guides a,
  .support-security p a {
    color: var(--accent);
    text-underline-offset: 4px;
  }

  .bug-report-intro a:not(.support-primary) {
    color: var(--accent-strong);
    text-underline-offset: 4px;
  }

  .support-groups {
    grid-column: 6 / 13;
    min-width: 0;
  }

  .support-group + .support-group {
    margin-top: 96px;
  }

  .support-group {
    scroll-margin-top: 32px;
  }

  .support-group-heading {
    margin-bottom: 32px;
  }

  .support-question {
    margin-top: 12px;
  }

  .support-question summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
    padding: 12px 0;
    color: var(--ink);
    font-size: 20px;
    font-weight: 650;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }

  .support-question summary::-webkit-details-marker {
    display: none;
  }

  .question-marker {
    position: relative;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--chip);
  }

  .question-marker::before,
  .question-marker::after {
    content: '';
    position: absolute;
    top: 17px;
    left: 10px;
    width: 16px;
    height: 2px;
    background: var(--ink);
  }

  .question-marker::after {
    transform: rotate(90deg);
  }

  .support-question[open] .question-marker::after {
    display: none;
  }

  .support-answer {
    padding: 0 60px 24px 0;
  }

  .support-answer p {
    max-width: 65ch;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .support-answer strong {
    color: var(--ink);
    font-weight: 650;
  }

  .bug-report {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px var(--page-gutter);
    margin: 144px var(--page-margin) 0;
    padding: clamp(28px, 4vw, 52px);
    background: var(--chip);
    scroll-margin-top: 32px;
  }

  .bug-report-intro {
    grid-column: 1 / 7;
  }

  .bug-report-intro > p {
    max-width: 52ch;
    margin: 24px 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .bug-report-intro .bug-note {
    margin: 24px 0 0;
    font-size: 14px;
  }

  .support-checklist {
    grid-column: 8 / 13;
    align-self: center;
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--ink);
    font-size: 16px;
    line-height: 1.5;
  }

  .support-checklist li :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--accent);
  }

  .support-security {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px var(--page-gutter);
    margin: 112px var(--page-margin) 144px;
  }

  .support-security h2 {
    grid-column: 1 / 7;
  }

  .support-security > div {
    grid-column: 8 / 13;
  }

  .support-security p {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  @media (hover: hover) {
    .support-index nav a:hover,
    .support-question summary:hover {
      color: var(--accent);
    }

    .support-primary:hover {
      background: #3b3145;
    }
  }

  @media (max-width: 900px) {
    .support-layout {
      display: block;
      margin-top: 88px;
    }

    .support-index {
      position: static;
      margin-bottom: 88px;
    }

    .support-index nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .support-index nav a {
      align-items: flex-start;
      padding: 12px 0;
    }

    .bug-report,
    .support-security {
      display: block;
    }

    .support-checklist {
      margin-top: 40px;
    }

    .support-security > div {
      margin-top: 32px;
    }
  }

  @media (max-width: 700px) {
    .support-layout {
      margin-top: 72px;
    }

    .support-index {
      margin-bottom: 72px;
    }

    .support-index nav {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 24px;
    }

    .support-index nav a {
      align-items: center;
      min-height: 52px;
    }

    .support-group + .support-group {
      margin-top: 72px;
    }

    .support-question summary {
      gap: 16px;
      font-size: 18px;
    }

    .support-answer {
      padding-right: 0;
    }

    .bug-report {
      margin-top: 88px;
    }

    .support-security {
      margin-top: 80px;
      margin-bottom: 96px;
    }
  }
</style>
