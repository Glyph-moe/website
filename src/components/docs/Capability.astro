---
interface Props {
  name: string
}
const { name } = Astro.props
---

<span class="cap">
  <code>{name}</code>
</span>

<style>
  .cap {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent-dim);
    vertical-align: baseline;
  }
  .cap code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: transparent;
    padding: 0;
  }
</style>
