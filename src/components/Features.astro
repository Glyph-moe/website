---
import ExtensionsTile from './tiles/ExtensionsTile.astro'
import OfflineTile from './tiles/OfflineTile.astro'
import PrivacyTile from './tiles/PrivacyTile.astro'
import SyncTile from './tiles/SyncTile.astro'
import CustomizationTile from './tiles/CustomizationTile.astro'
---

<section class="features" id="features">
  <div class="container">
    <h2 class="features-title">What Glyph does.</h2>
    <div class="bento-row bento-row-3">
      <ExtensionsTile />
      <OfflineTile />
      <PrivacyTile />
    </div>
    <div class="bento-row bento-row-2">
      <SyncTile />
      <CustomizationTile />
    </div>
  </div>
</section>

<style>
  .features {
    padding: 64px 0 96px;
    position: relative;
    z-index: 1;
  }

  .features-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.5vw, 24px);
    color: var(--text);
    margin-bottom: 20px;
    letter-spacing: -0.015em;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .bento-row {
    display: grid;
    gap: 14px;
    align-items: stretch;
  }
  .bento-row + .bento-row {
    margin-top: 14px;
  }
  .bento-row-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .bento-row-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 880px) {
    .bento-row-3,
    .bento-row-2 {
      grid-template-columns: 1fr;
    }
    .features {
      padding: 40px 0 64px;
    }
  }
</style>
