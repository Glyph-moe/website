---
import { Image } from 'astro:assets'
import ReaderDemo from './ReaderDemo.astro'
import extensionsShot from '../assets/screens/screen-extensions.png'
import downloadsShot from '../assets/screens/screen-downloads.png'
import settingsShot from '../assets/screens/screen-settings.png'

const rows = [
  {
    id: 'reading',
    eyebrow: 'Reading',
    title: 'Made for reading',
    body: 'Four themes, fine-grained typography, paginated or scroll. Tap below and try it — the reader gets out of the way and lets the prose breathe.',
    media: 'demo',
  },
  {
    id: 'extensions',
    eyebrow: 'Extensions',
    title: 'Bring your own sources',
    body: 'Community-built sources for any novel site. Add a repo URL, browse and search across all of them at once.',
    media: 'extensions',
  },
  {
    id: 'offline',
    eyebrow: 'Offline',
    title: 'Read anywhere',
    body: 'Download chapters once, read them anywhere. On a plane, in the subway, or in bed with no signal.',
    media: 'downloads',
  },
  {
    id: 'privacy',
    eyebrow: 'Privacy',
    title: 'Private by default',
    body: 'No accounts, no tracking, no ads. Your reading data stays on your device. Extensions run sandboxed with domain restrictions.',
    media: 'settings',
  },
]
---

<section class="features" id="features">
  <div class="container">
    <h2 class="visually-hidden">Features</h2>

    {
      rows.map((row, i) => (
        <div class={`feature-row ${i % 2 === 0 ? 'media-right' : 'media-left'}`}>
          <div class="feature-text">
            <span class="feature-eyebrow">{row.eyebrow}</span>
            <h3 class="feature-title">{row.title}</h3>
            <p class="feature-body">{row.body}</p>
          </div>
          <div class="feature-media">
            {row.media === 'demo' && <ReaderDemo />}
            {row.media === 'extensions' && (
              <div class="shot">
                <Image
                  src={extensionsShot}
                  alt="Extensions list in Glyph showing three installed sources."
                  widths={[280, 360, 480]}
                  sizes="(min-width: 768px) 360px, 80vw"
                />
              </div>
            )}
            {row.media === 'downloads' && (
              <div class="shot">
                <Image
                  src={downloadsShot}
                  alt="Manage Downloads screen showing 10 chapters available offline."
                  widths={[280, 360, 480]}
                  sizes="(min-width: 768px) 360px, 80vw"
                />
              </div>
            )}
            {row.media === 'settings' && (
              <div class="shot">
                <Image
                  src={settingsShot}
                  alt="Settings screen showing incognito mode, extensions, appearance, and reader themes."
                  widths={[280, 360, 480]}
                  sizes="(min-width: 768px) 360px, 80vw"
                />
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    padding: 60px 0 120px;
    position: relative;
    z-index: 1;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    padding: 80px 0;
  }

  .feature-row.media-left {
    direction: rtl;
  }
  .feature-row.media-left > * {
    direction: ltr;
  }

  .feature-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .feature-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 16px;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .feature-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 36ch;
  }

  .feature-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shot {
    max-width: 320px;
    width: 100%;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: 28px;
    box-shadow:
      0 1px 2px rgba(26, 22, 18, 0.04),
      0 16px 40px rgba(26, 22, 18, 0.12);
    display: block;
    border: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .feature-row,
    .feature-row.media-left {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 32px;
      padding: 48px 0;
      text-align: left;
    }
    .feature-row .feature-media {
      order: -1;
    }
    .feature-body {
      max-width: none;
    }
    .features {
      padding: 32px 0 80px;
    }
  }
</style>
