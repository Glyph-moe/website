---
const features = [
  {
    id: 'reading',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H12v18H5.5A1.5 1.5 0 0 1 4 19.5v-15z"/><path d="M20 4.5A1.5 1.5 0 0 0 18.5 3H12v18h6.5a1.5 1.5 0 0 0 1.5-1.5v-15z"/><path d="M7 8h2M7 11h2M15 8h2M15 11h2"/></svg>`,
    title: 'Made for reading',
    description:
      'Seven themes, fine-grained typography, paginated or scroll. The reader gets out of the way and lets the prose breathe.',
  },
  {
    id: 'extensions',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 3H12H8C6.34315 3 5 4.34315 5 6V18C5 19.6569 6.34315 21 8 21H11M13.5 3L19 8.625M13.5 3V7.625C13.5 8.17728 13.9477 8.625 14.5 8.625H19M19 8.625V11"/><path d="M17 15V18M17 21V18M17 18H14M17 18H20"/></svg>`,
    title: 'Extensions',
    description:
      'Community-built sources for any novel site. Add a repo URL, browse and search across all of them at once.',
  },
  {
    id: 'offline',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>`,
    title: 'Offline reading',
    description:
      'Download chapters once, read them anywhere. On a plane, in the subway, or in bed with no signal.',
  },
  {
    id: 'privacy',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>`,
    title: 'Private by default',
    description:
      'No accounts, no tracking, no ads. Your reading data stays on your device. Extensions run sandboxed with domain restrictions.',
  },
]
---

<section class="features" id="features">
  <div class="container features-layout">
    <h2 class="visually-hidden">Features</h2>

    <div class="phone-sticky">
      <div class="iphone">
        <div class="iphone-frame">
          <div class="dynamic-island"></div>
          <div class="iphone-screen">
            <!-- Screen: Reader -->
            <div class="screen screen-reader active" data-screen="reading">
              <div class="reader-surface">
                <div class="r-topbar">
                  <span class="r-chapter">Chapter 14</span>
                  <span class="r-progress">14 / 142</span>
                </div>
                <div class="r-body">
                  <p>
                    The rain hadn't stopped for three days. Elias sat at the window watching it
                    streak down the glass, each drop catching the lamplight before disappearing into
                    the dark below.
                  </p>
                  <p>
                    He thought about what the merchant had said. Not the warning — that part was
                    easy to dismiss. It was the other thing. The way the man's eyes had moved
                    when&hellip;
                  </p>
                </div>
                <div class="r-controls">
                  <div class="r-sizes">
                    <span class="r-size-small">A</span>
                    <span class="r-size-large">A</span>
                  </div>
                  <div class="r-themes">
                    <span class="r-theme" style="background:#ffffff;border-color:#e0d8c8;"></span>
                    <span class="r-theme active" style="background:#f5ecd9;border-color:#d9c9a8;"
                    ></span>
                    <span class="r-theme" style="background:#3a3a40;border-color:#3a3a40;"></span>
                    <span class="r-theme" style="background:#000;border-color:#000;"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Screen: Extensions -->
            <div class="screen screen-extensions" data-screen="extensions">
              <div class="s-nav"><span class="s-title">Browse</span></div>
              <div class="s-body">
                <div class="source-card">
                  <div class="source-icon" style="background: #2563eb;">
                    <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"
                      ><text
                        x="50%"
                        y="54%"
                        dominant-baseline="central"
                        text-anchor="middle"
                        fill="white"
                        font-size="16"
                        font-weight="700"
                        font-family="system-ui">R</text
                      ></svg
                    >
                  </div>
                  <div class="source-info">
                    <span class="source-name">Royal Road</span>
                    <span class="source-lang">EN</span>
                  </div>
                </div>
                <div class="source-card">
                  <div class="source-icon" style="background: #f97316;">
                    <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"
                      ><text
                        x="50%"
                        y="54%"
                        dominant-baseline="central"
                        text-anchor="middle"
                        fill="white"
                        font-size="16"
                        font-weight="700"
                        font-family="system-ui">N</text
                      ></svg
                    >
                  </div>
                  <div class="source-info">
                    <span class="source-name">NovelFire</span>
                    <span class="source-lang">EN</span>
                  </div>
                </div>
                <div class="source-card">
                  <div class="source-icon" style="background: #8b5cf6;">
                    <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"
                      ><text
                        x="50%"
                        y="54%"
                        dominant-baseline="central"
                        text-anchor="middle"
                        fill="white"
                        font-size="16"
                        font-weight="700"
                        font-family="system-ui">U</text
                      ></svg
                    >
                  </div>
                  <div class="source-info">
                    <span class="source-name">Novelish Universe</span>
                    <span class="source-lang">EN</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Screen: Offline -->
            <div class="screen screen-offline" data-screen="offline">
              <div class="s-nav"><span class="s-title">Downloads</span></div>
              <div class="s-body">
                <div class="dl-item">
                  <img
                    class="dl-cover"
                    src="https://picsum.photos/seed/shadow/64/88"
                    alt="Shadow Monarch cover"
                    width="32"
                    height="44"
                    loading="lazy"
                  />
                  <div class="dl-info">
                    <span class="dl-name">Shadow Monarch</span>
                    <span class="dl-meta">142 chapters &middot; 24 MB</span>
                  </div>
                  <div class="dl-check">&#10003;</div>
                </div>
                <div class="dl-item">
                  <img
                    class="dl-cover"
                    src="https://picsum.photos/seed/tbate/64/88"
                    alt="The Beginning After the End cover"
                    width="32"
                    height="44"
                    loading="lazy"
                  />
                  <div class="dl-info">
                    <span class="dl-name">The Beginning After the End</span>
                    <span class="dl-meta">86 chapters &middot; 18 MB</span>
                  </div>
                  <div class="dl-check">&#10003;</div>
                </div>
                <div class="dl-item downloading">
                  <img
                    class="dl-cover"
                    src="https://picsum.photos/seed/omniscient/64/88"
                    alt="Omniscient Reader cover"
                    width="32"
                    height="44"
                    loading="lazy"
                  />
                  <div class="dl-info">
                    <span class="dl-name">Omniscient Reader</span>
                    <div class="dl-progress"><div class="dl-bar"></div></div>
                  </div>
                  <span class="dl-pct">67%</span>
                </div>
              </div>
            </div>

            <!-- Screen: Privacy -->
            <div class="screen screen-privacy" data-screen="privacy">
              <div class="s-nav"><span class="s-title">Settings</span></div>
              <div class="s-body">
                <div class="pv-section">Filters &amp; Ratings</div>
                <div class="pv-row">
                  <span>Content Rating</span>
                  <span class="pv-value">Everyone</span>
                </div>
                <div class="pv-row">
                  <span>Blur Adult Covers</span>
                  <div class="pv-toggle on"></div>
                </div>
                <div class="pv-section">About</div>
                <div class="pv-row">
                  <span>iCloud Sync</span>
                  <span class="pv-value">Connected</span>
                </div>
                <div class="pv-row">
                  <span>Tracking</span>
                  <span class="pv-value accent">None</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="features-cards">
      {
        features.map((f, i) => (
          <div
            class="feature-card"
            data-feature={f.id}
            data-animate="fade-up"
            data-delay={String(i * 0.1)}
          >
            <div class="feature-icon" set:html={f.icon} />
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 40px 0 120px;
  }

  .features-layout {
    display: flex;
    gap: 64px;
    align-items: flex-start;
  }

  .features-cards {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .feature-card {
    padding: 28px 26px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-surface);
    transition:
      border-color 0.3s,
      background 0.3s;
    cursor: pointer;
    scroll-margin-top: 40vh;
  }

  .feature-card.active {
    border-color: rgba(239, 159, 39, 0.25);
    background: var(--bg-surface-hover);
  }

  .feature-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: var(--bg-surface-hover);
  }

  .feature-icon {
    color: var(--accent);
    margin-bottom: 20px;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .feature-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Phone column — desktop: sticky right; mobile: sticky top single-column */
  .phone-sticky {
    position: sticky;
    top: 120px;
    flex-shrink: 0;
    order: 2;
  }

  /* iPhone mockup */
  .iphone-frame {
    position: relative;
    width: 272px;
    height: 556px;
    border-radius: 48px;
    border: 3px solid var(--phone-border, rgba(255, 255, 255, 0.1));
    background: var(--phone-body, #000);
    padding: 8px;
    box-shadow:
      inset 0 0 0 1px var(--phone-border-inner, rgba(255, 255, 255, 0.04)),
      0 24px 64px var(--phone-shadow, rgba(0, 0, 0, 0.6));
    transition:
      background 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .dynamic-island {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 96px;
    height: 28px;
    background: var(--phone-body, #000);
    border-radius: 20px;
    z-index: 3;
    transition: background 0.3s;
  }

  .iphone-screen {
    width: 100%;
    height: 100%;
    border-radius: 40px;
    overflow: hidden;
    background: var(--phone-screen, #111116);
    position: relative;
    transition: background 0.3s;
  }

  /* Screens */
  .screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
  }

  .screen.active {
    opacity: 1;
  }

  .s-nav {
    padding: 52px 18px 12px;
    border-bottom: 1px solid var(--phone-surface-border);
  }

  .s-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--phone-text);
    letter-spacing: -0.02em;
  }

  .s-body {
    flex: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }

  /* Reader screen (sepia, regardless of site theme) */
  .reader-surface {
    flex: 1;
    background: #f5ecd9;
    color: #3a2e20;
    display: flex;
    flex-direction: column;
    padding: 48px 18px 14px;
  }

  .r-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    color: rgba(58, 46, 32, 0.55);
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }

  .r-chapter {
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .r-progress {
    font-variant-numeric: tabular-nums;
    font-size: 10px;
  }

  .r-body {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
  }

  .r-body p {
    font-size: 12px;
    line-height: 1.65;
    color: #3a2e20;
    margin: 0;
  }

  .r-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(58, 46, 32, 0.06);
  }

  .r-sizes {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: #3a2e20;
    font-family: Georgia, serif;
  }

  .r-size-small {
    font-size: 10px;
  }
  .r-size-large {
    font-size: 14px;
    font-weight: 600;
  }

  .r-themes {
    display: flex;
    gap: 6px;
  }

  .r-theme {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid;
    display: inline-block;
  }

  .r-theme.active {
    box-shadow: 0 0 0 2px var(--accent);
  }

  /* Extensions screen */
  .source-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: 12px;
    background: var(--phone-surface);
    border: 1px solid var(--phone-surface-border);
  }

  .source-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--phone-surface-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .source-icon svg {
    width: 100%;
    height: 100%;
  }

  .source-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .source-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--phone-text);
  }

  .source-lang {
    font-size: 10px;
    color: var(--phone-text-secondary);
    letter-spacing: 0.05em;
  }

  /* Offline screen */
  .dl-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 10px;
    background: var(--phone-surface);
  }

  .dl-cover {
    width: 32px;
    height: 44px;
    border-radius: 4px;
    background: var(--phone-surface-border);
    flex-shrink: 0;
    object-fit: cover;
  }

  .dl-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .dl-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--phone-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dl-meta {
    font-size: 10px;
    color: var(--phone-text-secondary);
  }

  .dl-check {
    font-size: 12px;
    color: #34c759;
    font-weight: 700;
  }

  .dl-progress {
    height: 3px;
    border-radius: 2px;
    background: var(--phone-surface-border);
    overflow: hidden;
  }

  .dl-bar {
    height: 100%;
    width: 67%;
    background: var(--accent);
    border-radius: 2px;
    animation: download 2s ease-in-out infinite;
  }

  @keyframes download {
    0% {
      width: 55%;
    }
    50% {
      width: 78%;
    }
    100% {
      width: 55%;
    }
  }

  .dl-pct {
    font-size: 10px;
    color: var(--accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Privacy screen */
  .pv-section {
    font-size: 11px;
    font-weight: 600;
    color: var(--phone-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 8px 0 4px;
  }

  .pv-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 0;
    border-bottom: 1px solid var(--phone-surface-border);
    font-size: 13px;
    color: var(--phone-text);
  }

  .pv-value {
    font-size: 12px;
    color: var(--phone-text-secondary);
  }

  .pv-value.accent {
    color: var(--accent);
    font-weight: 600;
  }

  .pv-toggle {
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: var(--phone-surface-border);
    position: relative;
  }

  .pv-toggle.on {
    background: #34c759;
  }

  .pv-toggle::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: white;
    top: 2px;
    left: 2px;
    transition: transform 0.2s;
  }

  .pv-toggle.on::after {
    transform: translateX(16px);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .features-layout {
      gap: 40px;
    }
    .iphone-frame {
      width: 240px;
      height: 490px;
      border-radius: 42px;
    }
    .iphone-screen {
      border-radius: 34px;
    }
    .dynamic-island {
      width: 80px;
      height: 24px;
      top: 12px;
    }
    .reader-surface {
      padding: 42px 16px 12px;
    }
  }

  @media (max-width: 768px) {
    .features-layout {
      flex-direction: column;
      align-items: stretch;
    }
    .phone-sticky {
      display: none;
    }
    .features {
      padding: 24px 0 80px;
    }
    .feature-card {
      padding: 22px 18px;
    }
    .feature-title {
      font-size: 16px;
    }
    .feature-desc {
      font-size: 13px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const cards = document.querySelectorAll('.feature-card[data-feature]')
  const screens = document.querySelectorAll('.screen[data-screen]')

  function setActiveScreen(id: string) {
    screens.forEach(s => s.classList.toggle('active', s.getAttribute('data-screen') === id))
    cards.forEach(c => c.classList.toggle('active', c.getAttribute('data-feature') === id))
  }

  cards.forEach((card, i) => {
    ScrollTrigger.create({
      trigger: card,
      start: 'top 65%',
      end: () => {
        const next = cards[i + 1] as HTMLElement | undefined
        if (next) {
          return `+=${next.offsetTop - (card as HTMLElement).offsetTop}`
        }
        return 'bottom top'
      },
      onToggle: ({ isActive }) => {
        if (isActive) setActiveScreen(card.getAttribute('data-feature')!)
      },
    })

    card.addEventListener('click', () => {
      setActiveScreen(card.getAttribute('data-feature')!)
    })
  })
</script>
