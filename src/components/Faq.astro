---
import Icon from './Icon.astro'

// Order leads with the trust/continuity questions readers ask first, then
// mechanics, then the soft stuff. The first item ships open so the section
// leads with an answer instead of a wall of closed rows.
const items = [
  {
    q: 'What is Glyph?',
    a: 'An iOS app for reading web novels. It has no content of its own; it connects to novel sites through community-built extensions. Think of it as a browser made for reading.',
    open: true,
  },
  {
    q: 'Is it free?',
    a: 'Yes. Free, no ads, no subscriptions, no in-app purchases. Not "free with a pro tier", just free.',
  },
  {
    q: 'Does it track me?',
    a: 'No analytics, no accounts, no tracking. Your reading data lives on your device, syncing to iCloud only if you’re signed in. Extensions run sandboxed with domain restrictions.',
  },
  {
    q: 'What if Apple pulls it from the store?',
    a: 'TestFlight first, and we’re building for sideloading too. More importantly, the extension SDK and format are open. The ecosystem doesn’t depend on any single app staying listed.',
  },
  {
    q: 'What if you stop working on it?',
    a: 'The SDK is open and the source format is documented. Sources keep working as long as sites do, and anyone can build or maintain extensions without us. The goal is something that survives its maker.',
  },
  {
    q: 'Is it open source?',
    a: 'The app itself isn’t, but the extension SDK, the WIT contract, and the docs are fully open. That’s the part that matters for keeping the ecosystem alive.',
  },
  {
    q: 'Can I import my library from another reader?',
    a: 'Not yet. Glyph is a novel reader, not a scan reader, so a library from something like Aidoku or Paperback isn’t a 1:1 match, different content entirely. What we’re working on is import by title: paste a list of novel names and Glyph will match them against your installed sources. No ETA, but it’s on the roadmap.',
  },
  {
    q: 'Where do extensions come from?',
    a: 'The community shares them as repository URLs. You add a URL in Settings → Extensions, fetch the available sources, and install. Anyone can build one with the SDK.',
  },
  {
    q: 'Can I read offline?',
    a: 'Yes. Download any chapter (or all of them) from a novel’s detail page. Downloads stay on your device and read without a connection.',
  },
  {
    q: 'When does it ship?',
    a: 'TestFlight in 2026–2027. Join the waitlist to get the link the day it goes out. One email, no spam.',
  },
  {
    q: 'Why the name Glyph?',
    a: 'A glyph is a single mark of meaning, the smallest unit of a written thing. It felt right for a reader.',
  },
]
---

<section class="faq" id="faq">
  <div class="container faq-grid">
    <aside class="faq-rail">
      <h2 class="faq-title">Questions</h2>
      <p class="faq-intro">
        Everything you might want to know before it ships. Real answers, no marketing.
      </p>
      <p class="faq-handoff">
        More in the <a href="/docs/faq">full FAQ</a>, or ask in
        <a href="https://github.com/Glyph-moe" target="_blank" rel="noopener">
          GitHub Discussions</a
        >.
      </p>
    </aside>

    <div class="faq-list">
      {
        items.map((it, i) => (
          <details class="faq-item" open={it.open}>
            <summary class="faq-q">
              <span class="faq-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q-text">{it.q}</span>
              <span class="faq-chevron" aria-hidden="true">
                <Icon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="faq-a">
              <p>{it.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 96px 0;
    position: relative;
    z-index: 1;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 64px;
    align-items: start;
  }

  /* --- Left rail: heading + intro + handoff ----------------------------- */
  .faq-rail {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .faq-intro {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 32ch;
    margin: 0;
  }

  .faq-handoff {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 8px 0 0;
    max-width: 32ch;
  }
  .faq-handoff a {
    color: var(--accent);
    border-bottom: 1px dotted var(--accent);
    padding-bottom: 1px;
    transition: border-bottom-style 0.18s ease;
  }
  .faq-handoff a:hover {
    border-bottom-style: solid;
  }

  /* --- Accordion -------------------------------------------------------- */
  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-top: 1px solid var(--border);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .faq-q {
    display: grid;
    grid-template-columns: 44px 1fr 24px;
    gap: 14px;
    align-items: baseline;
    padding: 20px 4px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.18s ease;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:hover .faq-q-text {
    color: var(--accent);
  }

  .faq-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1;
    color: var(--accent);
    font-variation-settings:
      'SOFT' 50,
      'opsz' 144,
      'WONK' 0;
  }

  .faq-q-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text);
    transition: color 0.18s ease;
  }

  .faq-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition:
      transform 0.22s ease,
      color 0.18s ease;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-a {
    padding: 0 4px 22px 58px;
    max-width: 62ch;
  }
  .faq-a p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 880px) {
    .faq {
      padding: 64px 0;
    }
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .faq-rail {
      position: static;
    }
    .faq-intro {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .faq-q {
      grid-template-columns: 32px 1fr 22px;
      gap: 10px;
      padding: 18px 2px;
    }
    .faq-num {
      font-size: 18px;
    }
    .faq-q-text {
      font-size: 16.5px;
    }
    .faq-a {
      padding: 0 2px 18px 44px;
    }
    .faq-a p {
      font-size: 14.5px;
    }
  }
</style>
