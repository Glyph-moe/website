---
const items = [
  {
    q: 'What is Glyph?',
    a: 'An iOS app for reading web novels. It has no content of its own; it connects to novel sites through community-built extensions. Think of it as a browser made for reading.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. Free, no ads, no subscriptions, no in-app purchases.',
  },
  {
    q: 'Where do extensions come from?',
    a: 'The community shares them as repository URLs. You add a URL in Settings → Extensions, fetch the available sources, and install. Anyone can build one with the SDK.',
  },
  {
    q: 'Can I read offline?',
    a: 'Yes. Download any chapter (or all of them) from a novel’s detail page. Downloads stay on your device and read without a connection.',
  },
  {
    q: 'Does it track me?',
    a: 'No analytics, no accounts, no tracking. Your reading data lives on your device, syncing to iCloud only if you’re signed in. Extensions run sandboxed with domain restrictions.',
  },
]
---

<section class="faq" id="faq">
  <div class="container">
    <h2 class="faq-title">Questions</h2>

    <ol class="faq-list">
      {
        items.map(it => (
          <li class="faq-item">
            <p class="faq-q">
              <span class="faq-marker">Q.</span>
              <span class="faq-text">{it.q}</span>
            </p>
            <p class="faq-a">
              <span class="faq-marker faq-marker-a">A.</span>
              <span class="faq-text">{it.a}</span>
            </p>
          </li>
        ))
      }
    </ol>

    <p class="faq-more">
      More questions in the <a href="/docs/faq">full FAQ</a>, or on
      <a href="https://discord.gg/hvA2sMRwxC" target="_blank" rel="noopener">Discord</a>.
    </p>
  </div>
</section>

<style>
  .faq {
    padding: 80px 0;
    position: relative;
    z-index: 1;
  }

  .faq-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 30px);
    color: var(--text);
    text-align: center;
    margin-bottom: 56px;
    letter-spacing: -0.015em;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .faq-list {
    list-style: none;
    max-width: 680px;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-q,
  .faq-a {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    margin: 0;
  }

  .faq-q .faq-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.4;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .faq-a .faq-text {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .faq-marker {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--accent);
    line-height: 1.4;
    font-variation-settings: 'SOFT' 70;
  }

  .faq-marker-a {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding-top: 4px;
  }

  .faq-more {
    text-align: center;
    margin-top: 56px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .faq-more a {
    color: var(--accent);
    border-bottom: 1px dotted var(--accent);
    padding-bottom: 1px;
    transition: border-bottom-style 0.18s ease;
  }
  .faq-more a:hover {
    border-bottom-style: solid;
  }

  @media (max-width: 640px) {
    .faq {
      padding: 56px 0;
    }
    .faq-q,
    .faq-a {
      grid-template-columns: 26px 1fr;
    }
    .faq-q .faq-text {
      font-size: 17px;
    }
    .faq-a .faq-text {
      font-size: 14.5px;
    }
  }
</style>
