---
// iPhone 16 Max frame wrapping a reader demo that mirrors the real NovelReader
// iOS app: 6 system-font themes, 3 size stops, real top/bottom chrome, and an
// Aa popover with size buttons + a 3x2 theme grid.
import Icon from './Icon.astro'

type ThemeId = 'white' | 'sepia' | 'gray' | 'slate' | 'dark' | 'black'

const themes: { id: ThemeId; label: string }[] = [
  { id: 'white', label: 'White' },
  { id: 'sepia', label: 'Sepia' },
  { id: 'gray', label: 'Gray' },
  { id: 'slate', label: 'Slate' },
  { id: 'dark', label: 'Dark' },
  { id: 'black', label: 'Black' },
]
---

<div class="reader-phone-wrap" data-theme="sepia" data-size="medium" data-menu-open="false">
  <iphone-16-max mode="dark" class="reader-phone-frame">
    <div class="reader-screen">
      <div class="reader-top">
        <button type="button" class="reader-back" aria-label="Back">
          <Icon name="chevron-left" size={16} />
        </button>
        <span class="reader-chapter">
          Ch. 14
          <span class="reader-dot">·</span>
          10%
        </span>
        <button type="button" class="reader-aa-btn" aria-label="Reader settings" data-aa-toggle>
          Aa
        </button>
      </div>

      <div class="reader-body">
        <p>
          The rain hadn't stopped for three days. Elias sat at the window watching it streak down
          the glass, each drop catching the lamplight before disappearing into the dark below.
        </p>
        <p>
          He thought about what the merchant had said. Not the warning — that part was easy to
          dismiss. It was the other thing. The way the man's eyes had moved when&hellip;
        </p>
      </div>

      <div class="reader-bottom">
        <div class="reader-bottom-row">
          <button type="button" class="reader-nav" aria-label="Previous chapter">
            <Icon name="chevron-left" size={16} />
          </button>
          <div class="reader-progress" aria-hidden="true">
            <div class="reader-progress-fill"></div>
          </div>
          <button type="button" class="reader-nav" aria-label="Next chapter">
            <Icon name="chevron-right" size={16} />
          </button>
        </div>
        <div class="reader-bottom-meta">
          <span>14 of 142</span>
          <span>~2 min left</span>
        </div>
      </div>

      <div class="reader-popover" role="dialog" aria-label="Reader settings" aria-hidden="true">
        <div class="reader-popover-section">
          <span class="reader-popover-label">Size</span>
          <div class="reader-sizes" role="group" aria-label="Font size">
            <button type="button" class="size-btn" data-size="small" aria-label="Small text">
              <span class="size-glyph size-small">Aa</span>
            </button>
            <button type="button" class="size-btn" data-size="medium" aria-label="Medium text">
              <span class="size-glyph size-medium">Aa</span>
            </button>
            <button type="button" class="size-btn" data-size="large" aria-label="Large text">
              <span class="size-glyph size-large">Aa</span>
            </button>
          </div>
        </div>

        <div class="reader-popover-section">
          <span class="reader-popover-label">Theme</span>
          <div class="reader-themes" role="group" aria-label="Reader theme">
            {
              themes.map(t => (
                <button
                  type="button"
                  class={`theme-card theme-card--${t.id}`}
                  data-theme={t.id}
                  aria-label={t.label}
                >
                  <span class="theme-swatch">
                    <span class="theme-swatch-aa">Aa</span>
                  </span>
                  <span class="theme-name">{t.label}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </iphone-16-max>
</div>

<style>
  .reader-phone-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .reader-phone-frame {
    --width: 280px;
    width: 280px;
  }

  /* --- Theme palette (real NovelReader values) ---------------------------- */
  .reader-phone-wrap[data-theme='white'] .reader-screen {
    --bg: #ffffff;
    --ink: #121212;
    --theme-accent: #007aff;
  }
  .reader-phone-wrap[data-theme='sepia'] .reader-screen {
    --bg: #f8eddc;
    --ink: #47331f;
    --theme-accent: #b5651d;
  }
  .reader-phone-wrap[data-theme='gray'] .reader-screen {
    --bg: #e8e8ed;
    --ink: #2c2c2e;
    --theme-accent: #636366;
  }
  .reader-phone-wrap[data-theme='slate'] .reader-screen {
    --bg: #2c2c2e;
    --ink: #dadadf;
    --theme-accent: #64d2ff;
  }
  .reader-phone-wrap[data-theme='dark'] .reader-screen {
    --bg: #1a1a1e;
    --ink: #d9d9e0;
    --theme-accent: #0a84ff;
  }
  .reader-phone-wrap[data-theme='black'] .reader-screen {
    --bg: #000000;
    --ink: #a0a0a5;
    --theme-accent: #5e5ce6;
  }

  /* --- Screen surface ------------------------------------------------------ */
  .reader-screen {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 48px 0 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  /* --- Top bar ------------------------------------------------------------ */
  .reader-top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    height: 44px;
    color: color-mix(in oklab, var(--ink) 85%, transparent);
  }

  .reader-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 4px;
    color: inherit;
    cursor: pointer;
    border-radius: 6px;
    opacity: 0.85;
  }

  .reader-chapter {
    justify-self: center;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .reader-dot {
    opacity: 0.4;
    margin: 0 4px;
  }

  .reader-aa-btn {
    background: transparent;
    border: 0;
    padding: 4px 6px;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    opacity: 0.9;
    transition: opacity 0.15s ease;
  }
  .reader-aa-btn:hover {
    opacity: 1;
  }

  /* --- Reading body ------------------------------------------------------- */
  .reader-body {
    flex: 1 1 auto;
    overflow: hidden;
    padding: 4px 18px 8px;
    color: var(--ink);
    line-height: 1.8;
    word-spacing: 0.02em;
    letter-spacing: 0;
    transition: font-size 0.2s ease;
  }

  .reader-phone-wrap[data-size='small'] .reader-body {
    font-size: 15px;
  }
  .reader-phone-wrap[data-size='medium'] .reader-body {
    font-size: 17px;
  }
  .reader-phone-wrap[data-size='large'] .reader-body {
    font-size: 20px;
  }

  .reader-body p {
    margin: 0 0 0.9em;
  }
  .reader-body p:last-child {
    margin-bottom: 0;
  }

  /* --- Bottom bar --------------------------------------------------------- */
  .reader-bottom {
    padding: 10px 14px 12px;
    color: var(--ink);
  }

  .reader-bottom-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
  }

  .reader-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 4px;
    color: inherit;
    cursor: pointer;
    border-radius: 6px;
    opacity: 0.75;
  }
  .reader-nav:hover {
    opacity: 1;
  }

  .reader-progress {
    position: relative;
    height: 4px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--ink) 15%, transparent);
    overflow: hidden;
  }

  .reader-progress-fill {
    width: 10%;
    height: 100%;
    border-radius: 4px;
    background: color-mix(in oklab, var(--ink) 60%, transparent);
  }

  .reader-bottom-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    font-size: 10px;
    font-weight: 500;
    opacity: 0.55;
    letter-spacing: 0;
  }

  /* --- Popover (Aa sheet) ------------------------------------------------- */
  .reader-popover {
    position: absolute;
    top: 50px;
    left: 14px;
    right: 14px;
    padding: 14px;
    border-radius: 14px;
    background: rgba(248, 248, 250, 0.96);
    color: #1a1612;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    z-index: 4;
  }

  .reader-phone-wrap[data-menu-open='true'] .reader-popover {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .reader-popover-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .reader-popover-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  /* Size buttons */
  .reader-sizes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .size-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 10px;
    padding: 10px 6px;
    cursor: pointer;
    color: #1a1612;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
    line-height: 1;
    transition:
      color 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease;
  }
  .size-btn:hover {
    background: rgba(0, 0, 0, 0.07);
  }
  .reader-phone-wrap[data-size='small'] .size-btn[data-size='small'],
  .reader-phone-wrap[data-size='medium'] .size-btn[data-size='medium'],
  .reader-phone-wrap[data-size='large'] .size-btn[data-size='large'] {
    color: var(--accent);
    background: rgba(179, 93, 29, 0.08);
    border-color: rgba(179, 93, 29, 0.35);
  }

  .size-glyph {
    display: inline-block;
  }
  .size-small {
    font-size: 13px;
  }
  .size-medium {
    font-size: 16px;
  }
  .size-large {
    font-size: 19px;
  }

  /* Theme grid (3 columns × 2 rows) */
  .reader-themes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 8px;
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .theme-swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 56px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
    transition: border-color 0.18s ease;
  }

  .theme-swatch-aa {
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
  }

  .theme-name {
    font-size: 11px;
    color: #1a1612;
    opacity: 0.75;
    letter-spacing: 0;
  }

  /* Per-card swatch colors (independent of current reader theme) */
  .theme-card--white .theme-swatch {
    background: #ffffff;
  }
  .theme-card--white .theme-swatch-aa {
    color: #121212;
  }
  .theme-card--sepia .theme-swatch {
    background: #f8eddc;
  }
  .theme-card--sepia .theme-swatch-aa {
    color: #47331f;
  }
  .theme-card--gray .theme-swatch {
    background: #e8e8ed;
  }
  .theme-card--gray .theme-swatch-aa {
    color: #2c2c2e;
  }
  .theme-card--slate .theme-swatch {
    background: #2c2c2e;
    border-color: rgba(255, 255, 255, 0.08);
  }
  .theme-card--slate .theme-swatch-aa {
    color: #dadadf;
  }
  .theme-card--dark .theme-swatch {
    background: #1a1a1e;
    border-color: rgba(255, 255, 255, 0.08);
  }
  .theme-card--dark .theme-swatch-aa {
    color: #d9d9e0;
  }
  .theme-card--black .theme-swatch {
    background: #000000;
    border-color: rgba(255, 255, 255, 0.08);
  }
  .theme-card--black .theme-swatch-aa {
    color: #a0a0a5;
  }

  /* Selected theme card: 2.5px accent border + bolder name */
  .reader-phone-wrap[data-theme='white'] .theme-card--white .theme-swatch,
  .reader-phone-wrap[data-theme='sepia'] .theme-card--sepia .theme-swatch,
  .reader-phone-wrap[data-theme='gray'] .theme-card--gray .theme-swatch,
  .reader-phone-wrap[data-theme='slate'] .theme-card--slate .theme-swatch,
  .reader-phone-wrap[data-theme='dark'] .theme-card--dark .theme-swatch,
  .reader-phone-wrap[data-theme='black'] .theme-card--black .theme-swatch {
    border: 2.5px solid var(--accent);
  }
  .reader-phone-wrap[data-theme='white'] .theme-card--white .theme-name,
  .reader-phone-wrap[data-theme='sepia'] .theme-card--sepia .theme-name,
  .reader-phone-wrap[data-theme='gray'] .theme-card--gray .theme-name,
  .reader-phone-wrap[data-theme='slate'] .theme-card--slate .theme-name,
  .reader-phone-wrap[data-theme='dark'] .theme-card--dark .theme-name,
  .reader-phone-wrap[data-theme='black'] .theme-card--black .theme-name {
    font-weight: 600;
    opacity: 1;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .reader-phone-frame {
      --width: 240px;
      width: 240px;
    }
    .reader-screen {
      padding: 44px 0 0;
    }
    .reader-body {
      padding: 4px 14px 8px;
    }
    .reader-bottom {
      padding: 8px 12px 10px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.reader-phone-wrap').forEach(root => {
    const aaBtn = root.querySelector<HTMLButtonElement>('[data-aa-toggle]')
    const popover = root.querySelector<HTMLElement>('.reader-popover')

    function setMenu(open: boolean) {
      root.setAttribute('data-menu-open', String(open))
      if (popover) popover.setAttribute('aria-hidden', String(!open))
    }

    aaBtn?.addEventListener('click', e => {
      e.stopPropagation()
      const isOpen = root.getAttribute('data-menu-open') === 'true'
      setMenu(!isOpen)
    })

    root.querySelectorAll<HTMLButtonElement>('.theme-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme')
        if (theme) root.setAttribute('data-theme', theme)
      })
    })

    root.querySelectorAll<HTMLButtonElement>('.size-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size')
        if (size) root.setAttribute('data-size', size)
      })
    })

    // Dismiss popover on outside click within the wrap
    document.addEventListener('click', e => {
      if (!root.contains(e.target as Node)) return
      const target = e.target as HTMLElement
      if (target.closest('[data-aa-toggle]')) return
      if (target.closest('.reader-popover')) return
      setMenu(false)
    })
  })
</script>
