---
// Framed live reader for standalone use (hero). Wraps the frame-less
// ReaderScreen in an iphone-16-max frame and centers it.
import ReaderScreen from './ReaderScreen.astro'
---

<div class="reader-phone-outer">
  <iphone-16-max mode="dark" class="reader-phone-frame">
    <ReaderScreen />
  </iphone-16-max>
</div>

<style>
  .reader-phone-outer {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .reader-phone-frame {
    --width: 280px;
    width: 280px;
  }

  .reader-phone-frame :global(.reader-phone-wrap) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .reader-phone-frame {
      --width: 240px;
      width: 240px;
    }
  }
</style>
