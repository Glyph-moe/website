---
/**
 * The cover template.
 *
 * A cover is not an image per post. It is one of three base paintings — dawn,
 * dusk, night — cropped to the post's own focus (`cx`), with the title set in
 * Newsreader on top of it. Same component everywhere: a card in the grid, the
 * wide hero on the index, the band at the top of a post.
 *
 * The painting is decorative (alt=""); the title is real text, so it is
 * selectable, translatable, indexed, and readable by a screen reader.
 *
 * Nothing on the cover waits for the network. The box has its aspect ratio
 * from the first frame, a wash in the mood's colour paints immediately, and
 * the painting's own 24px thumbnail sits under the title — then the real crop
 * fades in over it. The only class the script adds is `is-loaded`.
 */
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { formatDate } from '../../lib/blog'
import paintingDawn from '../../assets/blog/painting-dawn.webp'
import paintingDusk from '../../assets/blog/painting-dusk.webp'
import paintingNight from '../../assets/blog/painting-night.webp'

type Mood = 'dawn' | 'dusk' | 'night'

interface Props {
  mood: Mood
  title: string
  category?: string
  date?: Date
  /** Horizontal crop focus of the painting, 0–1. */
  cx?: number
  size?: 'card' | 'wide'
  /** False on a post page, where the h1 above already says the title. */
  showTitle?: boolean
  showMeta?: boolean
  /** Set on cards, so the title is a heading in the page outline. */
  heading?: 'h2' | 'h3'
  /** The cover above the fold: load it first, not lazily. */
  priority?: boolean
  /** In the first row of the grid: load now, but below the hero's priority. */
  eager?: boolean
  /** A rare exception: a real image instead of the painted template. */
  image?: ImageMetadata
  class?: string
}

const {
  mood,
  title,
  category,
  date,
  cx = 0.68,
  size = 'card',
  showTitle = true,
  showMeta = true,
  heading,
  priority = false,
  eager = false,
  image,
  class: className = '',
} = Astro.props

const paintings: Record<Mood, ImageMetadata> = {
  dawn: paintingDawn,
  dusk: paintingDusk,
  night: paintingNight,
}

const isWide = size === 'wide'
const Title = heading ?? 'p'

/**
 * A card crops a 4:5 window out of a 16:9 painting, so only ~45% of the image
 * width survives the crop. Asking for roughly twice the card's own width in
 * `sizes` makes the browser fetch a source wide enough for the crop to stay
 * sharp; on the wide band the full width is visible and no oversampling is
 * needed.
 */
const widths = isWide
  ? [640, 800, 960, 1280, 1600, 1920, 2000]
  : [320, 400, 480, 640, 800, 960, 1200, 1440, 1600, 1920]
const sizes = isWide
  ? '(min-width: 1240px) 1184px, 100vw'
  : '(min-width: 981px) 66vw, (min-width: 621px) 96vw, 202vw'
---

<div
  class:list={['cover', isWide ? 'cover--wide' : 'cover--card', className]}
  data-mood={mood}
  style={`--cx: ${(cx * 100).toFixed(1)}%`}
>
  <span class="cover-wash" aria-hidden="true"></span>
  <span class="cover-lqip" aria-hidden="true"></span>

  <Picture
    src={image ?? paintings[mood]}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={48}
    widths={widths}
    sizes={sizes}
    alt=""
    class="cover-art"
    pictureAttributes={{ class: 'cover-art-picture' }}
    style={`object-position: ${(cx * 100).toFixed(1)}% 64%`}
    loading={priority || eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
  />

  <div class="cover-veil" aria-hidden="true"></div>

  {
    showMeta && category && (
      <span class="cover-pill cover-pill--category glass">
        <span class="cover-pill-text">{category}</span>
      </span>
    )
  }

  <div class:list={['cover-center', !showTitle && 'cover-center--sun-only']}>
    <svg class="cover-sun" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <g
        fill="none"
        stroke="var(--sun)"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M20.4 12.6c4.1-.4 7.6 3 7.5 7.2-.1 4-3.4 7.2-7.4 7.1-4-.1-7.2-3.3-7.1-7.3.1-3.9 3.2-7 7-7z"
        ></path>
        <path d="M20.1 4.4c.7 1.6.9 3.1.8 4.6"></path>
        <path d="M31.7 8.7c-1.1 1.3-2.1 2.2-3.3 3"></path>
        <path d="M35.5 20.2c-1.7.5-3.1.6-4.6.4"></path>
        <path d="M8.4 8.4c1.2 1.2 2.1 2.2 2.8 3.4"></path>
        <path d="M4.6 19.4c1.6.6 2.9.9 4.4.9"></path>
        <path d="M11.5 29.9c1.4-1 2.6-1.6 3.9-2"></path>
        <path d="M28.8 30.4c-1.3-1-2.5-1.6-3.7-2.1"></path>
      </g>
    </svg>
    {
      showTitle && (
        <Title class="cover-title" data-cover-title>
          {title}
        </Title>
      )
    }
  </div>

  {
    showMeta && date && (
      <span class="cover-pill cover-pill--date glass">
        <span class="cover-pill-text">
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        </span>
      </span>
    )
  }
</div>
