---
import Logo from './Logo.astro'
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-logo" data-animate="fade-up">
      <Logo size={56} />
    </div>
    <h1 class="hero-title" data-animate="fade-up" data-delay="0.1">
      Read novels,<br />your way.
    </h1>
    <p class="hero-subtitle" data-animate="fade-up" data-delay="0.2">
      A free iOS reader for web novels. Bring your own sources, customize every detail, read
      offline. No accounts. No tracking.
    </p>
    <div class="hero-actions" data-animate="fade-up" data-delay="0.3">
      <a href="https://discord.gg/hvA2sMRwxC" target="_blank" rel="noopener" class="btn-primary">
        Join the Discord
      </a>
      <a href="/docs/getting-started" class="btn-secondary">Read the docs</a>
    </div>
    <p class="hero-note" data-animate="fade-up" data-delay="0.4">
      TestFlight invites coming soon. We'll announce in Discord.
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 100px 0 60px;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .hero-logo {
    margin-bottom: 8px;
  }

  .hero-title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--text);
  }

  .hero-subtitle {
    font-size: clamp(16px, 2.5vw, 19px);
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }

  .btn-primary {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    padding: 12px 28px;
    border-radius: 10px;
    border: none;
    background: var(--accent);
    color: #0e0e12;
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary:hover {
    opacity: 0.92;
  }

  .btn-secondary {
    font-size: 14px;
    font-weight: 500;
    padding: 12px 28px;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    transition:
      color 0.2s,
      border-color 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-secondary:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .hero-note {
    font-size: 13px;
    color: var(--text-secondary);
    opacity: 0.7;
    margin-top: 4px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 90px 0 48px;
      min-height: auto;
    }
    .hero-title {
      font-size: 36px;
    }
    .hero-subtitle {
      font-size: 15px;
    }
    .hero-logo :global(svg) {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
