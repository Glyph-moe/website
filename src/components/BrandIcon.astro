const hidden = ariaLabel ? undefined : 'true'
const sizeAttr = typeof size === 'number' ? `${size}` : size
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={sizeAttr}
  height={sizeAttr}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  aria-label={ariaLabel}
  aria-hidden={hidden}
  set:html={`<path d="${path}" />`}
/>
