---
// Single Fraunces sentence between hero and features.
// Sits low-contrast, generous whitespace, no decoration.
---

<section class="prose-beat">
  <div class="container">
    <p class="prose-beat-line">
      Web novels deserve a reader. Not a feed, not a content app — a place where prose breathes.
    </p>
  </div>
</section>

<style>
  .prose-beat {
    padding: 120px 0;
    position: relative;
    z-index: 1;
  }

  .prose-beat-line {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 4.2vw, 40px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
    text-align: center;
    max-width: 22ch;
    margin: 0 auto;
    font-variation-settings:
      'SOFT' 50,
      'opsz' 144;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .prose-beat {
      padding: 80px 0;
    }
  }
</style>
