---
import WaitlistForm from './WaitlistForm.astro'
---

<section class="closing">
  <div class="container">
    <p class="closing-line">The iOS reader<br />for people who actually read.</p>
    <WaitlistForm variant="hero" />
    <ul class="closing-badges" aria-label="Glyph principles">
      <li>Free</li>
      <li>No ads</li>
      <li>No IAP</li>
      <li>No tracking</li>
      <li>Open SDK</li>
    </ul>
  </div>
</section>

<style>
  .closing {
    padding: 120px 0;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .closing-line {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    max-width: 20ch;
    margin: 0 auto 32px;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 144;
  }

  .closing :global(.waitlist) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }
  .closing :global(.waitlist-row) {
    margin: 0 auto;
  }

  .closing-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 24px auto 0;
  }
  .closing-badges li {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    padding: 5px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  @media (max-width: 640px) {
    .closing {
      padding: 72px 0;
    }
  }
</style>
