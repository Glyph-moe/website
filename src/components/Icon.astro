---
import * as lucideIcons from 'lucide-static'

interface Props {
  name: string
  size?: number | string
  strokeWidth?: number | string
  class?: string
  ariaLabel?: string
}

const { name, size = '1em', strokeWidth = 2, class: className, ariaLabel } = Astro.props

// lucide-static exports each icon as a PascalCase named export (e.g. `Sun`,
// `Moon`, `Puzzle`). Map a kebab-case `name` prop (e.g. "arrow-down") to that
// PascalCase key.
const pascal = name
  .split('-')
  .map(part => part.charAt(0).toUpperCase() + part.slice(1))
  .join('')

const icons = lucideIcons as unknown as Record<string, string>
const raw = icons[pascal] ?? icons[name]

if (!raw) {
  throw new Error(`Icon "${name}" not found in lucide-static`)
}

// lucide-static gives us full <svg ...>...</svg> markup. We rewrite the opening
// tag to apply size + strokeWidth + accessibility attrs while keeping the inner
// paths verbatim. Pattern: capture inner content between <svg ...> and </svg>.
const innerMatch = raw.match(/<svg[^>]*>([\s\S]*)<\/svg>/)
const inner = innerMatch ? innerMatch[1] : raw

const sizeAttr = typeof size === 'number' ? `${size}` : size
const sw = typeof strokeWidth === 'number' ? `${strokeWidth}` : strokeWidth
const hidden = ariaLabel ? undefined : 'true'
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={sizeAttr}
  height={sizeAttr}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-label={ariaLabel}
  aria-hidden={hidden}
  set:html={inner}
/>
