---
// Interactive reader demo. Theme dots + font-size chips drive sample paragraph live.
// State lives on the .reader-demo root via data attributes; CSS reads them.
---

<div class="reader-demo" data-theme="sepia" data-size="medium">
  <div class="reader-demo-surface">
    <div class="reader-demo-topbar">
      <span class="reader-demo-chapter">Chapter 14</span>
      <span class="reader-demo-progress">14 / 142</span>
    </div>
    <div class="reader-demo-body">
      <p>
        The rain hadn't stopped for three days. Elias sat at the window watching it streak down the
        glass, each drop catching the lamplight before disappearing into the dark below.
      </p>
      <p>
        He thought about what the merchant had said. Not the warning — that part was easy to
        dismiss. It was the other thing. The way the man's eyes had moved when&hellip;
      </p>
    </div>
  </div>

  <div class="reader-demo-controls">
    <div class="reader-demo-sizes" role="group" aria-label="Font size">
      <button type="button" class="size-btn" data-size="small" aria-label="Small text">
        <span class="size-small">A</span>
      </button>
      <button type="button" class="size-btn" data-size="medium" aria-label="Medium text">
        <span class="size-medium">A</span>
      </button>
      <button type="button" class="size-btn" data-size="large" aria-label="Large text">
        <span class="size-large">A</span>
      </button>
    </div>
    <div class="reader-demo-themes" role="group" aria-label="Reader theme">
      <button
        type="button"
        class="theme-btn"
        data-theme="white"
        aria-label="White theme"
        style="--swatch:#ffffff;--swatch-border:#e0d8c8;"></button>
      <button
        type="button"
        class="theme-btn"
        data-theme="sepia"
        aria-label="Sepia theme"
        style="--swatch:#f5ecd9;--swatch-border:#d9c9a8;"></button>
      <button
        type="button"
        class="theme-btn"
        data-theme="warm-dark"
        aria-label="Warm dark theme"
        style="--swatch:#1a1612;--swatch-border:#1a1612;"></button>
      <button
        type="button"
        class="theme-btn"
        data-theme="black"
        aria-label="Black theme"
        style="--swatch:#000000;--swatch-border:#000000;"></button>
    </div>
  </div>
</div>

<style>
  .reader-demo {
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }

  .reader-demo-surface {
    border-radius: var(--radius-lg);
    padding: 28px 24px 22px;
    transition:
      background 0.2s ease,
      color 0.2s ease;
    border: 1px solid var(--border);
    box-shadow:
      0 1px 2px rgba(26, 22, 18, 0.04),
      0 16px 40px rgba(26, 22, 18, 0.12);
  }

  /* Theme styles — read from .reader-demo[data-theme] */
  .reader-demo[data-theme='white'] .reader-demo-surface {
    background: #ffffff;
    color: #1d1d1f;
  }
  .reader-demo[data-theme='sepia'] .reader-demo-surface {
    background: #f5ecd9;
    color: #3a2e20;
  }
  .reader-demo[data-theme='warm-dark'] .reader-demo-surface {
    background: #1a1612;
    color: #ece6dc;
  }
  .reader-demo[data-theme='black'] .reader-demo-surface {
    background: #000000;
    color: #c8c8c8;
  }

  .reader-demo-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 14px;
  }

  .reader-demo-body {
    font-family: 'Iowan Old Style', 'Charter', Georgia, 'Times New Roman', serif;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: font-size 0.2s ease;
  }

  /* Size styles */
  .reader-demo[data-size='small'] .reader-demo-body {
    font-size: 14px;
  }
  .reader-demo[data-size='medium'] .reader-demo-body {
    font-size: 16px;
  }
  .reader-demo[data-size='large'] .reader-demo-body {
    font-size: 18px;
  }

  .reader-demo-body p {
    margin: 0;
  }

  .reader-demo-controls {
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 4px;
  }

  .reader-demo-sizes,
  .reader-demo-themes {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .size-btn {
    background: transparent;
    border: 0;
    padding: 4px 6px;
    cursor: pointer;
    color: var(--text-secondary);
    font-family: 'Iowan Old Style', Georgia, serif;
    line-height: 1;
    border-radius: 6px;
    transition:
      color 0.18s ease,
      background 0.18s ease;
  }
  .size-btn:hover {
    color: var(--text);
  }
  .reader-demo[data-size='small'] .size-btn[data-size='small'],
  .reader-demo[data-size='medium'] .size-btn[data-size='medium'],
  .reader-demo[data-size='large'] .size-btn[data-size='large'] {
    color: var(--accent);
  }
  .size-small {
    font-size: 11px;
  }
  .size-medium {
    font-size: 14px;
  }
  .size-large {
    font-size: 18px;
  }

  .theme-btn {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--swatch);
    border: 1px solid var(--swatch-border);
    cursor: pointer;
    padding: 0;
    transition: box-shadow 0.18s ease;
  }
  .reader-demo[data-theme='white'] .theme-btn[data-theme='white'],
  .reader-demo[data-theme='sepia'] .theme-btn[data-theme='sepia'],
  .reader-demo[data-theme='warm-dark'] .theme-btn[data-theme='warm-dark'],
  .reader-demo[data-theme='black'] .theme-btn[data-theme='black'] {
    box-shadow: 0 0 0 2px var(--accent);
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.reader-demo').forEach(root => {
    root.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme')
        if (theme) root.setAttribute('data-theme', theme)
      })
    })
    root.querySelectorAll<HTMLButtonElement>('.size-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size')
        if (size) root.setAttribute('data-size', size)
      })
    })
  })
</script>
